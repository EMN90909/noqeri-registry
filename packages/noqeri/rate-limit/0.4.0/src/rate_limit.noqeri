module noqeri.rate_limit

export function rateLimitRefill(tokens: i64, capacity: i64, elapsedMillis: i64, tokensPerSecond: i64): i64 {
    if capacity <= 0 as i64 { return 0 as i64 }
    let current: i64 = tokens
    if current < 0 as i64 { current = 0 as i64 }
    if current >= capacity { return capacity }
    if elapsedMillis <= 0 as i64 || tokensPerSecond <= 0 as i64 { return current }
    let room: i64 = capacity - current
    let seconds: i64 = elapsedMillis / 1000 as i64
    if seconds > room / tokensPerSecond { return capacity }
    let whole: i64 = seconds * tokensPerSecond
    if whole >= room { return capacity }
    let remainderMillis: i64 = elapsedMillis % 1000 as i64
    let secondsRate: i64 = tokensPerSecond / 1000 as i64
    let remainderRate: i64 = tokensPerSecond % 1000 as i64
    let fractional: i64 = remainderMillis * secondsRate + (remainderMillis * remainderRate) / 1000 as i64
    if fractional >= room - whole { return capacity }
    return current + whole + fractional
}

export function rateLimitAllowed(tokens: i64, cost: i64): bool {
    return cost > 0 as i64 && tokens >= cost
}

export function rateLimitConsume(tokens: i64, cost: i64): i64 {
    if !rateLimitAllowed(tokens, cost) { return tokens }
    return tokens - cost
}

export function rateLimitRetryAfterMillis(tokens: i64, cost: i64, tokensPerSecond: i64): i64 {
    if cost <= 0 as i64 { return 0 as i64 }
    let available: i64 = tokens
    if available < 0 as i64 { available = 0 as i64 }
    if available >= cost { return 0 as i64 }
    if tokensPerSecond <= 0 as i64 { return -1 as i64 }
    let missing: i64 = cost - available
    let wholeSeconds: i64 = missing / tokensPerSecond
    let remainderTokens: i64 = missing % tokensPerSecond
    let limit: i64 = 9223372036854775807 as i64
    if wholeSeconds > limit / 1000 as i64 { return limit }
    let wholeMillis: i64 = wholeSeconds * 1000 as i64
    if remainderTokens == 0 as i64 { return wholeMillis }
    // Find the minimum milliseconds that refill the remaining fractional tokens.
    // Decompose the rate first, avoiding overflow in milliseconds * rate.
    let low: i64 = 0 as i64
    let high: i64 = 1000 as i64
    let rateWhole: i64 = tokensPerSecond / 1000 as i64
    let rateRemainder: i64 = tokensPerSecond % 1000 as i64
    while low < high {
        let middle: i64 = (low + high) / 2 as i64
        let produced: i64 = middle * rateWhole + (middle * rateRemainder) / 1000 as i64
        if produced >= remainderTokens { high = middle } else { low = middle + 1 as i64 }
    }
    if low > limit - wholeMillis { return limit }
    return wholeMillis + low
}
