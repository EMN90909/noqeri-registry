import "../src/rate_limit.noqeri"
function main(): int {
    if rateLimitRefillMillis(0 as i64,10 as i64,250 as i64,8 as i64) != 2 as i64 { return 1 }
    if rateLimitRefillMillis(9 as i64,10 as i64,10000 as i64,8 as i64) != 10 as i64 { return 2 }
