import "../src/rate_limit.noqeri"
function main(): int {
    if rateLimitRefill(5 as i64, 100 as i64, 1000 as i64, 5 as i64) != 10 as i64 { return 1 }
    if rateLimitRefill(5 as i64, 100 as i64, 9223372036854775807 as i64, 9223372036854775807 as i64) != 100 as i64 { return 2 }
    if rateLimitRefill(-10 as i64, 100 as i64, 0 as i64, 5 as i64) != 0 as i64 { return 3 }
    return 0
}
