module noqeri.ai.eval

// Allocation-free evaluation for scalar regressors and binary classifiers.
// Class index 1 is positive; confusion slots are [TP, FP, TN, FN].
export function evalMeanSquaredError(predicted: []float, actual: []float,
                                     result: []float): bool {
    if len(predicted) == 0 as usize || len(predicted) != len(actual) || len(result) == 0 as usize { return false }
    let total: float = 0.0
    let i: usize = 0 as usize
    while i < len(predicted) {
        let diff: float = predicted[i] - actual[i]
        total = total + diff * diff
        i = i + 1 as usize
    }
    result[0 as usize] = total / len(predicted) as float
    return true
}
export function evalMeanAbsoluteError(predicted: []float, actual: []float,
                                      result: []float): bool {
    if len(predicted) == 0 as usize || len(predicted) != len(actual) || len(result) == 0 as usize { return false }
    let total: float = 0.0
    let i: usize = 0 as usize
    while i < len(predicted) {
        let diff: float = predicted[i] - actual[i]
        if diff < 0.0 { total = total - diff }
        else { total = total + diff }
        i = i + 1 as usize
    }
    result[0 as usize] = total / len(predicted) as float
    return true
}
export function evalBinaryConfusion(scores: []float, truth: []u8,
                                    threshold: float, counts: []usize): bool {
    if len(scores) == 0 as usize || len(scores) != len(truth) ||
       len(scores) > 1000000 as usize || len(counts) < 4 as usize ||
       !(threshold >= 0.0 && threshold <= 1.0) { return false }
    // Complete validation before modifying the caller-owned counts.
    let i: usize = 0 as usize
    while i < len(scores) {
        if truth[i] > 1 as u8 || !(scores[i] >= 0.0 && scores[i] <= 1.0) { return false }
        i = i + 1 as usize
    }
    i = 0 as usize
    while i < 4 as usize { counts[i] = 0 as usize i = i + 1 as usize }
    i = 0 as usize
    while i < len(scores) {
        let predicted: bool = scores[i] >= threshold
        if predicted && truth[i] == 1 as u8 { counts[0 as usize] = counts[0 as usize] + 1 as usize }
        else if predicted { counts[1 as usize] = counts[1 as usize] + 1 as usize }
        else if truth[i] == 0 as u8 { counts[2 as usize] = counts[2 as usize] + 1 as usize }
        else { counts[3 as usize] = counts[3 as usize] + 1 as usize }
        i = i + 1 as usize
    }
    return true
}
export function evalPrecision(counts: []usize): float {
    if len(counts) < 4 as usize { return 0.0 }
    let total: usize = counts[0 as usize] + counts[1 as usize]
    if total == 0 as usize { return 0.0 }
    return counts[0 as usize] as float / total as float
}
export function evalRecall(counts: []usize): float {
    if len(counts) < 4 as usize { return 0.0 }
    let total: usize = counts[0 as usize] + counts[3 as usize]
    if total == 0 as usize { return 0.0 }
    return counts[0 as usize] as float / total as float
}
export function evalF1(counts: []usize): float {
    let p: float = evalPrecision(counts)
    let r: float = evalRecall(counts)
    if p + r == 0.0 { return 0.0 }
    return 2.0 * p * r / (p + r)
}
export function evalAccuracy(counts: []usize): float {
    if len(counts) < 4 as usize { return 0.0 }
    let total: usize = counts[0 as usize] + counts[1 as usize] +
                       counts[2 as usize] + counts[3 as usize]
    if total == 0 as usize { return 0.0 }
    return (counts[0 as usize] + counts[2 as usize]) as float / total as float
}
export function evalArgmax(scores: []float): isize {
    if len(scores) == 0 as usize { return -1 as isize }
    let best: usize = 0 as usize
    let i: usize = 0 as usize
    while i < len(scores) {
        if !(scores[i] == scores[i]) { return -1 as isize }
        if scores[i] > scores[best] { best = i }
        i = i + 1 as usize
    }
    return best as isize
}
export function evalTopKContains(scores: []float, expected: usize, k: usize): bool {
    if len(scores) == 0 as usize || expected >= len(scores) ||
       k == 0 as usize || k > len(scores) { return false }
    let ahead: usize = 0 as usize
    let i: usize = 0 as usize
    while i < len(scores) {
        if !(scores[i] == scores[i]) { return false }
        if scores[i] > scores[expected] ||
           (scores[i] == scores[expected] && i < expected) { ahead = ahead + 1 as usize }
        i = i + 1 as usize
    }
    return ahead < k
}
