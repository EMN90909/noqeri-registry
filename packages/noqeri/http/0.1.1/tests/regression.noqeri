import "../src/http.noqeri"
function main(): int {
let h: [u8; 4] = [72 as u8,111 as u8,115 as u8,116 as u8]
    let newline: [u8; 2] = [13 as u8,10 as u8]
    if !httpHeaderNameValid(slice(h)) || httpHeaderValueValid(slice(newline)) { return 1 }
    let data: [u8; 3] = [65 as u8,32 as u8,38 as u8]
    let output: [u8; 7] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    if httpEncodeQuery(slice(data),slice(output)) != 7 as isize { return 2 }
    if output[1] != 37 as u8 || output[2] != 50 as u8 || output[3] != 48 as u8 { return 3 }
    if !httpRetryable(503) || httpRetryable(404) || httpBodyAllowed(204) { return 4 }
    return 0
}
print(main())
