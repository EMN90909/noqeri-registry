module noqeri.http

export function httpStatusClass(status: int): int { if status < 100 || status > 599 { return 0 } return status / 100 }
export function httpIsSuccess(status: int): bool { return status >= 200 && status <= 299 }
export function httpIsRedirect(status: int): bool { return status >= 300 && status <= 399 }
export function httpIsClientError(status: int): bool { return status >= 400 && status <= 499 }
export function httpIsServerError(status: int): bool { return status >= 500 && status <= 599 }
export function httpMethodIsSafe(method: int): bool { return method == 1 || method == 2 }

// REGISTRY_CAPABILITY_UPGRADE_V2
export function httpHeaderNameByteValid(c: u8): bool {
    if (c >= 65 as u8 && c <= 90 as u8) || (c >= 97 as u8 && c <= 122 as u8) || (c >= 48 as u8 && c <= 57 as u8) { return true }
    return c == 45 as u8 || c == 95 as u8 || c == 33 as u8 || c == 35 as u8 || c == 36 as u8 || c == 37 as u8 || c == 38 as u8 || c == 39 as u8 || c == 42 as u8 || c == 43 as u8 || c == 94 as u8 || c == 96 as u8 || c == 124 as u8 || c == 126 as u8
}
export function httpHeaderNameValid(name: []u8): bool {
    if len(name) == 0 as usize { return false }
    let i: usize = 0 as usize
    while i < len(name) { if !httpHeaderNameByteValid(name[i]) { return false } i = i + 1 as usize }
    return true
}
export function httpHeaderValueValid(value: []u8): bool {
    let i: usize = 0 as usize
    while i < len(value) {
        if value[i] == 10 as u8 || value[i] == 13 as u8 || value[i] == 0 as u8 { return false }
        i = i + 1 as usize
    }
    return true
}
export function httpResponseBodyAllowed(status: int): bool { return status != 204 && status != 304 && (status < 100 || status >= 200) }

export function httpMethodAllowedName(method: string): bool {
 return method == "GET" || method == "HEAD" || method == "POST" || method == "PUT" || method == "PATCH" || method == "DELETE" || method == "OPTIONS"
}
export function httpMethodIdempotentName(method: string): bool {
 return method == "GET" || method == "HEAD" || method == "PUT" || method == "DELETE" || method == "OPTIONS"
}
export function httpStatusRetryable(status: int): bool {
 return status == 408 || status == 425 || status == 429 || status == 500 || status == 502 || status == 503 || status == 504
}
export function httpRequestBodySizeValid(bytes: usize): bool { return bytes <= 8388608 as usize }
export function httpHeaderLineSizeValid(name: []u8, value: []u8): bool {
 return len(name) <= 256 as usize && len(value) <= 8192 as usize && httpHeaderNameValid(name) && httpHeaderValueValid(value)
}
export function httpContentLengthValid(bytes: usize, maximum: usize): bool {
 return maximum <= 67108864 as usize && bytes <= maximum
}
