// SPDX-License-Identifier: MIT
// CSV: quote-doubling, strict cell decoding and row field counting.
module noqeri.csv

export function csvDelimiterValid(c: u8): bool { return c == 44 as u8 || c == 59 as u8 || c == 9 as u8 || c == 124 as u8 }
export function csvIsNewline(c: u8): bool { return c == 10 as u8 || c == 13 as u8 }
export function csvNeedsQuoting(data: []u8, delimiter: u8): bool {
    let i: usize = 0 as usize
    while i < len(data) {
        let c: u8 = data[i]
        if c == delimiter || c == 34 as u8 || csvIsNewline(c) { return true }
        i = i + 1 as usize
    }
    return false
}
export function csvQuotedSize(data: []u8, delimiter: u8): usize {
    let total: usize = len(data)
    if !csvNeedsQuoting(data, delimiter) { return total }
    total = total + 2 as usize
    let i: usize = 0 as usize
    while i < len(data) {
        if data[i] == 34 as u8 { total = total + 1 as usize }
        i = i + 1 as usize
    }
    return total
}
export function csvEncodeCell(data: []u8, destination: []u8, delimiter: u8): isize {
    if !csvDelimiterValid(delimiter) { return -1 as isize }
    let quoted: bool = csvNeedsQuoting(data,delimiter)
    let required: usize = csvQuotedSize(data,delimiter)
    if len(destination) < required { return -1 as isize }
    let out: usize = 0 as usize
    if quoted { destination[out] = 34 as u8 out = out + 1 as usize }
    let i: usize = 0 as usize
    while i < len(data) {
        destination[out] = data[i]
        out = out + 1 as usize
        if quoted && data[i] == 34 as u8 { destination[out] = 34 as u8 out = out + 1 as usize }
        i = i + 1 as usize
    }
    if quoted { destination[out] = 34 as u8 out = out + 1 as usize }
    return out as isize
}
export function csvCellValid(data: []u8, delimiter: u8): bool {
    if !csvDelimiterValid(delimiter) { return false }
    let count: usize = len(data)
    if count == 0 as usize { return true }
    if data[0] != 34 as u8 {
        let i: usize = 0 as usize
        while i < count {
            if data[i] == 34 as u8 || data[i] == delimiter || csvIsNewline(data[i]) { return false }
            i = i + 1 as usize
        }
        return true
    }
    if count < 2 as usize || data[count - 1 as usize] != 34 as u8 { return false }
    let i: usize = 1 as usize
    while i + 1 as usize < count {
        if data[i] == 34 as u8 {
            if i + 1 as usize >= count - 1 as usize || data[i + 1 as usize] != 34 as u8 { return false }
            i = i + 1 as usize
        }
        i = i + 1 as usize
    }
    return true
}
export function csvDecodedSize(data: []u8, delimiter: u8): isize {
    if !csvCellValid(data,delimiter) { return -1 as isize }
    if len(data) == 0 as usize { return 0 as isize }
    if data[0] != 34 as u8 { return len(data) as isize }
    let out: usize = 0 as usize
    let i: usize = 1 as usize
    while i < len(data) - 1 as usize {
        if data[i] == 34 as u8 { i = i + 1 as usize }
        out = out + 1 as usize
        i = i + 1 as usize
    }
    return out as isize
}
export function csvDecodeCell(data: []u8, destination: []u8, delimiter: u8): isize {
    let need: isize = csvDecodedSize(data,delimiter)
    if need < 0 as isize || len(destination) < need as usize { return -1 as isize }
    let i: usize = 0 as usize
    let end: usize = len(data)
    if len(data) > 0 as usize && data[0] == 34 as u8 { i = 1 as usize end = end - 1 as usize }
    let out: usize = 0 as usize
    while i < end {
        destination[out] = data[i]
        if data[i] == 34 as u8 { i = i + 1 as usize }
        out = out + 1 as usize
        i = i + 1 as usize
    }
    return out as isize
}
export function csvFieldsCount(row: []u8, delimiter: u8): isize {
    if !csvDelimiterValid(delimiter) { return -1 as isize }
    let fieldCount: isize = 1 as isize
    let state: int = 0
    let i: usize = 0 as usize
    while i < len(row) {
        let c: u8 = row[i]
        if state == 1 {
            if c == 34 as u8 {
                if i + 1 as usize < len(row) && row[i + 1 as usize] == 34 as u8 { i = i + 1 as usize }
                else { state = 2 }
            }
        } else if state == 2 {
            if c == delimiter { fieldCount = fieldCount + 1 as isize state = 0 }
            else { return -1 as isize }
        } else {
            if c == delimiter { fieldCount = fieldCount + 1 as isize }
            else if c == 34 as u8 { state = 1 }
            else if csvIsNewline(c) { return -1 as isize }
        }
        i = i + 1 as usize
    }
    if state == 1 { return -1 as isize }
    return fieldCount
}
export function csvHeaderSafe(columns: usize, rowBytes: usize): bool {
    return columns > 0 as usize && columns <= 4096 as usize && rowBytes <= 4194304 as usize
}


// Scan a complete CSV document, not merely a single row. Quoted CRLF/LF
// are data; outside quotes they are row separators. Strict quote state is
// enforced and malformed or unclosed records fail with -1.
export function csvDocumentRowCount(data: []u8, delimiter: u8): isize {
    if !csvDelimiterValid(delimiter) { return -1 as isize }
    if len(data) == 0 as usize { return 0 as isize }
    let count: isize = 0 as isize
    let state: int = 0 // 0 start, 1 plain, 2 quoted, 3 quote closed
    let i: usize = 0 as usize
    while i < len(data) {
        let c: u8 = data[i]
        if state == 0 {
            if c == 34 as u8 { state = 2 }
            else if c == delimiter { state = 0 }
            else if c == 10 as u8 || c == 13 as u8 {
                count = count + 1 as isize
                if c == 13 as u8 && i + 1 as usize < len(data) && data[i + 1 as usize] == 10 as u8 { i = i + 1 as usize }
            } else { state = 1 }
        } else if state == 1 {
            if c == 34 as u8 { return -1 as isize }
            if c == delimiter { state = 0 }
            else if c == 10 as u8 || c == 13 as u8 {
                state = 0
                count = count + 1 as isize
                if c == 13 as u8 && i + 1 as usize < len(data) && data[i + 1 as usize] == 10 as u8 { i = i + 1 as usize }
            }
        } else if state == 2 {
            if c == 34 as u8 { state = 3 }
        } else {
            if c == 34 as u8 { state = 2 }
            else if c == delimiter { state = 0 }
            else if c == 10 as u8 || c == 13 as u8 {
                state = 0
                count = count + 1 as isize
                if c == 13 as u8 && i + 1 as usize < len(data) && data[i + 1 as usize] == 10 as u8 { i = i + 1 as usize }
            } else { return -1 as isize }
        }
        i = i + 1 as usize
    }
    if state == 2 { return -1 as isize }
    let last: u8 = data[len(data) - 1 as usize]
    if last != 10 as u8 && last != 13 as u8 { count = count + 1 as isize }
    return count
}
// Use when exporting to spreadsheet software: consumers should prefix or
// neutralize formula-like cells instead of blindly writing user input.
export function csvSpreadsheetFormulaRisk(value: []u8): bool {
    if len(value) == 0 as usize { return false }
    let i: usize = 0 as usize
    while i < len(value) && value[i] == 32 as u8 { i = i + 1 as usize }
    if i >= len(value) { return false }
    let c: u8 = value[i]
    return c == 61 as u8 || c == 43 as u8 || c == 45 as u8 || c == 64 as u8 || c == 9 as u8 || c == 13 as u8 || c == 10 as u8
}
