// SPDX-License-Identifier: GPL-3.0-only
module noqeri.csv

record CsvField {
    start: usize
    length: usize
    quoted: bool
}

export function csvDelimiterValid(value: u8): bool { return value == 44 as u8 || value == 59 as u8 || value == 9 as u8 || value == 124 as u8 }
export function csvColumnCountValid(count: usize): bool { return count > 0 as usize && count <= 4096 as usize }
export function csvRowBytesValid(bytes: usize): bool { return bytes <= 4 as usize * 1024 as usize * 1024 as usize }
export function csvIsLineBreak(c: u8): bool { return c == 10 as u8 || c == 13 as u8 }

export function csvNeedsQuoteWithDelimiter(value: []u8, delimiter: u8): bool {
    let i: usize = 0 as usize
    while i < len(value) {
        let c: u8 = value[i]
        if c == delimiter || c == 34 as u8 || csvIsLineBreak(c) { return true }
        i = i + 1 as usize
    }
    return false
}

export function csvNeedsQuote(value: []u8): bool { return csvNeedsQuoteWithDelimiter(value, 44 as u8) }

// Finds one field beginning at start. next receives the delimiter position or
// record length; field receives the raw span including surrounding quotes.
export function csvNextField(record: []u8, start: usize, delimiter: u8, field: *CsvField, next: *usize): bool {
    if field == null || next == null || !csvDelimiterValid(delimiter) || start > len(record) { return false }
    if start == len(record) {
        field.start = start
        field.length = 0 as usize
        field.quoted = false
        unsafe { *next = start }
        return true
    }
    let index: usize = start
    let quoted: bool = record[index] == 34 as u8
    if quoted {
        index = index + 1 as usize
        let closed: bool = false
        while index < len(record) && !closed {
            if record[index] == 34 as u8 {
                if index + 1 as usize < len(record) && record[index + 1 as usize] == 34 as u8 { index = index + 2 as usize }
                else { index = index + 1 as usize closed = true }
            } else { index = index + 1 as usize }
        }
        if !closed { return false }
        if index < len(record) && record[index] != delimiter { return false }
    } else {
        while index < len(record) && record[index] != delimiter {
            if record[index] == 34 as u8 || csvIsLineBreak(record[index]) { return false }
            index = index + 1 as usize
        }
    }
    field.start = start
    field.length = index - start
    field.quoted = quoted
    unsafe { *next = index }
    return true
}

export function csvCountColumnsWithDelimiter(record: []u8, delimiter: u8): usize {
    if !csvDelimiterValid(delimiter) { return 0 as usize }
    if len(record) == 0 as usize { return 1 as usize }
    let field_bytes: [u8; 32] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let field: *CsvField = (&field_bytes[0 as usize]) as *CsvField
    let count: usize = 0 as usize
    let start: usize = 0 as usize
    while start <= len(record) {
        let next: usize = start
        if !csvNextField(record, start, delimiter, field, &next) { return 0 as usize }
        count = count + 1 as usize
        if next >= len(record) { return count }
        start = next + 1 as usize
        if start == len(record) { return count + 1 as usize }
    }
    return count
}

export function csvCountColumns(record: []u8): usize { return csvCountColumnsWithDelimiter(record, 44 as u8) }
export function csvRecordValid(record: []u8): bool { return csvCountColumns(record) > 0 as usize }

export function csvUnescapedLength(field: []u8): isize {
    if len(field) == 0 as usize { return 0 as isize }
    if field[0 as usize] != 34 as u8 { return len(field) as isize }
    if len(field) < 2 as usize || field[len(field) - 1 as usize] != 34 as u8 { return -1 as isize }
    let output: usize = 0 as usize
    let i: usize = 1 as usize
    while i + 1 as usize < len(field) {
        if field[i] == 34 as u8 {
            if i + 1 as usize >= len(field) - 1 as usize || field[i + 1 as usize] != 34 as u8 { return -1 as isize }
            output = output + 1 as usize
            i = i + 2 as usize
        } else { output = output + 1 as usize i = i + 1 as usize }
    }
    return output as isize
}

export function csvUnescape(field: []u8, destination: []u8): isize {
    let required: isize = csvUnescapedLength(field)
    if required < 0 as isize || required as usize > len(destination) { return -1 as isize }
    if len(field) == 0 as usize { return 0 as isize }
    let input: usize = 0 as usize
    let end: usize = len(field)
    if field[0 as usize] == 34 as u8 { input = 1 as usize end = len(field) - 1 as usize }
    let output: usize = 0 as usize
    while input < end {
        if field[input] == 34 as u8 && input + 1 as usize < end && field[input + 1 as usize] == 34 as u8 { destination[output] = 34 as u8 input = input + 2 as usize }
        else { destination[output] = field[input] input = input + 1 as usize }
        output = output + 1 as usize
    }
    return output as isize
}

export function csvEscapedLengthWithDelimiter(value: []u8, delimiter: u8): usize {
    if !csvNeedsQuoteWithDelimiter(value, delimiter) { return len(value) }
    let size: usize = 2 as usize
    let i: usize = 0 as usize
    while i < len(value) { if value[i] == 34 as u8 { size = size + 2 as usize } else { size = size + 1 as usize } i = i + 1 as usize }
    return size
}

export function csvEscapedLength(value: []u8): usize { return csvEscapedLengthWithDelimiter(value, 44 as u8) }

function csvEscapeAt(value: []u8, destination: []u8, offset: usize, delimiter: u8): isize {
    if !csvDelimiterValid(delimiter) || offset > len(destination) { return -1 as isize }
    let required: usize = csvEscapedLengthWithDelimiter(value, delimiter)
    if required > len(destination) - offset { return -1 as isize }
    if !csvNeedsQuoteWithDelimiter(value, delimiter) {
        let i: usize = 0 as usize
        while i < len(value) { destination[offset + i] = value[i] i = i + 1 as usize }
        return required as isize
    }
    let output: usize = offset
    destination[output] = 34 as u8
    output = output + 1 as usize
    let input: usize = 0 as usize
    while input < len(value) {
        if value[input] == 34 as u8 {
            destination[output] = 34 as u8
            destination[output + 1 as usize] = 34 as u8
            output = output + 2 as usize
        } else { destination[output] = value[input] output = output + 1 as usize }
        input = input + 1 as usize
    }
    destination[output] = 34 as u8
    return required as isize
}

export function csvEscapeWithDelimiter(value: []u8, destination: []u8, delimiter: u8): isize { return csvEscapeAt(value, destination, 0 as usize, delimiter) }
export function csvEscape(value: []u8, destination: []u8): isize { return csvEscapeWithDelimiter(value, destination, 44 as u8) }

export function csvJoin2(first: []u8, second: []u8, destination: []u8, delimiter: u8): isize {
    if !csvDelimiterValid(delimiter) { return -1 as isize }
    let first_len: usize = csvEscapedLengthWithDelimiter(first, delimiter)
    let second_len: usize = csvEscapedLengthWithDelimiter(second, delimiter)
    let required: usize = first_len + 1 as usize + second_len
    if len(destination) < required { return -1 as isize }
    if csvEscapeAt(first, destination, 0 as usize, delimiter) < 0 as isize { return -1 as isize }
    destination[first_len] = delimiter
    if csvEscapeAt(second, destination, first_len + 1 as usize, delimiter) < 0 as isize { return -1 as isize }
    return required as isize
}

// MIT-licensed complementary implementations brought forward from v0.1.1.
export function csvIsNewline(c: u8): bool { return c == 10 as u8 || c == 13 as u8 }

export function csvNeedsQuoting(data: []u8, delimiter: u8): bool {
    let i: usize = 0 as usize
    while i < len(data) {
        let c: u8 = data[i]
        if c == delimiter || c == 34 as u8 || csvIsNewline(c) { return true }
        i = i + 1 as usize
    }
    return false
}

export function csvQuotedSize(data: []u8, delimiter: u8): usize {
    let total: usize = len(data)
    if !csvNeedsQuoting(data, delimiter) { return total }
    total = total + 2 as usize
    let i: usize = 0 as usize
    while i < len(data) {
        if data[i] == 34 as u8 { total = total + 1 as usize }
        i = i + 1 as usize
    }
    return total
}

export function csvEncodeCell(data: []u8, destination: []u8, delimiter: u8): isize {
    if !csvDelimiterValid(delimiter) { return -1 as isize }
    let quoted: bool = csvNeedsQuoting(data,delimiter)
    let required: usize = csvQuotedSize(data,delimiter)
    if len(destination) < required { return -1 as isize }
    let out: usize = 0 as usize
    if quoted { destination[out] = 34 as u8 out = out + 1 as usize }
    let i: usize = 0 as usize
    while i < len(data) {
        destination[out] = data[i]
        out = out + 1 as usize
        if quoted && data[i] == 34 as u8 { destination[out] = 34 as u8 out = out + 1 as usize }
        i = i + 1 as usize
    }
    if quoted { destination[out] = 34 as u8 out = out + 1 as usize }
    return out as isize
}

export function csvCellValid(data: []u8, delimiter: u8): bool {
    if !csvDelimiterValid(delimiter) { return false }
    let count: usize = len(data)
    if count == 0 as usize { return true }
    if data[0] != 34 as u8 {
        let i: usize = 0 as usize
        while i < count {
            if data[i] == 34 as u8 || data[i] == delimiter || csvIsNewline(data[i]) { return false }
            i = i + 1 as usize
        }
        return true
    }
    if count < 2 as usize || data[count - 1 as usize] != 34 as u8 { return false }
    let i: usize = 1 as usize
    while i + 1 as usize < count {
        if data[i] == 34 as u8 {
            if i + 1 as usize >= count - 1 as usize || data[i + 1 as usize] != 34 as u8 { return false }
            i = i + 1 as usize
        }
        i = i + 1 as usize
    }
    return true
}

export function csvDecodedSize(data: []u8, delimiter: u8): isize {
    if !csvCellValid(data,delimiter) { return -1 as isize }
    if len(data) == 0 as usize { return 0 as isize }
    if data[0] != 34 as u8 { return len(data) as isize }
    let out: usize = 0 as usize
    let i: usize = 1 as usize
    while i < len(data) - 1 as usize {
        if data[i] == 34 as u8 { i = i + 1 as usize }
        out = out + 1 as usize
        i = i + 1 as usize
    }
    return out as isize
}

export function csvDecodeCell(data: []u8, destination: []u8, delimiter: u8): isize {
    let need: isize = csvDecodedSize(data,delimiter)
    if need < 0 as isize || len(destination) < need as usize { return -1 as isize }
    let i: usize = 0 as usize
    let end: usize = len(data)
    if len(data) > 0 as usize && data[0] == 34 as u8 { i = 1 as usize end = end - 1 as usize }
    let out: usize = 0 as usize
    while i < end {
        destination[out] = data[i]
        if data[i] == 34 as u8 { i = i + 1 as usize }
        out = out + 1 as usize
        i = i + 1 as usize
    }
    return out as isize
}

export function csvFieldsCount(row: []u8, delimiter: u8): isize {
    if !csvDelimiterValid(delimiter) { return -1 as isize }
    let fieldCount: isize = 1 as isize
    let state: int = 0
    let i: usize = 0 as usize
    while i < len(row) {
        let c: u8 = row[i]
        if state == 1 {
            if c == 34 as u8 {
                if i + 1 as usize < len(row) && row[i + 1 as usize] == 34 as u8 { i = i + 1 as usize }
                else { state = 2 }
            }
        } else if state == 2 {
            if c == delimiter { fieldCount = fieldCount + 1 as isize state = 0 }
            else { return -1 as isize }
        } else {
            if c == delimiter { fieldCount = fieldCount + 1 as isize }
            else if c == 34 as u8 { state = 1 }
            else if csvIsNewline(c) { return -1 as isize }
        }
        i = i + 1 as usize
    }
    if state == 1 { return -1 as isize }
    return fieldCount
}

export function csvHeaderSafe(columns: usize, rowBytes: usize): bool {
    return columns > 0 as usize && columns <= 4096 as usize && rowBytes <= 4194304 as usize
}
