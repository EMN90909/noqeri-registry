import "../src/csv.noqeri"
function main(): int {
    let multiline: [u8; 10] = [34 as u8,97 as u8,10 as u8,98 as u8,34 as u8,44 as u8,50 as u8,10 as u8,51 as u8,10 as u8]
    let malformed: [u8; 3] = [34 as u8,97 as u8,10 as u8]
    let risk: [u8; 3] = [32 as u8,61 as u8,49 as u8]
    if csvDocumentRowCount(slice(multiline),44 as u8) != 2 as isize { return 1 }
    if csvDocumentRowCount(slice(malformed),44 as u8) != -1 as isize { return 2 }
    if !csvSpreadsheetFormulaRisk(slice(risk)) { return 3 }
    return 0
}
print(main())
