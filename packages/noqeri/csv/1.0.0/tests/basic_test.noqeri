import "../src/csv.nqr"

function main(): int {
    let record: [u8; 19] = [65 as u8,108 as u8,105 as u8,99 as u8,101 as u8,44 as u8,34 as u8,78 as u8,97 as u8,105 as u8,114 as u8,111 as u8,98 as u8,105 as u8,44 as u8,32 as u8,75 as u8,69 as u8,34 as u8]
    if !csvRecordValid(slice(record)) || csvCountColumns(slice(record)) != 2 as usize { return 1 }

    let field: [u8; 9] = [97 as u8,44 as u8,98 as u8,34 as u8,99 as u8,10 as u8,100 as u8,101 as u8,102 as u8]
    if !csvNeedsQuote(slice(field)) { return 2 }
    let escaped: [u8; 16] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let written: isize = csvEscape(slice(field), slice(escaped))
    if written != 12 as isize { return 3 }
    let restored: [u8; 12] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    if csvUnescape(slice(escaped), slice(restored)) != 9 as isize { return 4 }
    let i: usize = 0 as usize
    while i < 9 as usize { if restored[i] != field[i] { return 5 } i = i + 1 as usize }

    let first: [u8; 3] = [97 as u8,44 as u8,98 as u8]
    let second: [u8; 2] = [111 as u8,107 as u8]
    let row: [u8; 16] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    if csvJoin2(slice(first), slice(second), slice(row), 44 as u8) != 8 as isize { return 6 }
    let row_expected: [u8; 8] = [34 as u8,97 as u8,44 as u8,98 as u8,34 as u8,44 as u8,111 as u8,107 as u8]
    i = 0 as usize
    while i < 8 as usize { if row[i] != row_expected[i] { return 7 } i = i + 1 as usize }

    let semicolon: [u8; 5] = [97 as u8,59 as u8,98 as u8,59 as u8,99 as u8]
    if csvCountColumnsWithDelimiter(slice(semicolon), 59 as u8) != 3 as usize { return 8 }
    let malformed: [u8; 4] = [34 as u8,97 as u8,44 as u8,98 as u8]
    if csvRecordValid(slice(malformed)) { return 9 }
    return 0
}
