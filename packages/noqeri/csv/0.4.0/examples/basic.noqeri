import "../src/csv.nqr"

function main(): int {
    let first: [u8; 3] = [97 as u8,44 as u8,98 as u8]
    let second: [u8; 2] = [111 as u8,107 as u8]
    let row: [u8; 8] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    if csvJoin2(slice(first), slice(second), slice(row), 44 as u8) != 8 as isize { return 1 }
    if csvCountColumns(slice(row)) != 2 as usize { return 2 }
    return 0
}
