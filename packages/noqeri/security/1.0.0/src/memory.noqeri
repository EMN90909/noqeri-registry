module noqeri.security

export function nqConstantTimeEqual(left: []u8, right: []u8): bool { if len(left) != len(right) { return false } let diff: u8 = 0 as u8 let i: usize = 0 as usize while i < len(left) { if left[i] != right[i] { diff = 1 as u8 } i = i + 1 } return diff == 0 as u8 }
export function nqClearBytes(value: []u8): void { let i: usize = 0 as usize while i < len(value) { value[i] = 0 as u8 i = i + 1 } }
export function nqAllZero(value: []u8): bool { let i: usize = 0 as usize while i < len(value) { if value[i] != 0 as u8 { return false } i = i + 1 } return true }
