import "../src/memory.nqr"
function main(): int {
    if !zeroMemoryChecked(null as *volatile u8, 0 as usize) { return 1 }
    if zeroMemoryChecked(null as *volatile u8, 2 as usize) { return 2 }
    if !validRange(4 as usize, 2 as usize, 6 as usize) { return 3 }
    if validRange(5 as usize, 2 as usize, 6 as usize) { return 4 }
    return 0
}
