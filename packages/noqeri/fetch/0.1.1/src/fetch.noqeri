module noqeri.fetch
extern function fetchStart(url: string): usize
extern function fetchStatus(handle: usize): int
extern function fetchText(handle: usize): string
extern function fetchCancel(handle: usize): bool
export function fetchHandleValid(h: usize): bool { return h != 0 as usize }
export function fetchHttpStatusValid(code: int): bool { return code >= 100 && code <= 599 }
export function fetchStatusDone(code: int): bool { return code < 0 || code >= 200 }
export function fetchStatusOk(code: int): bool { return code >= 200 && code <= 299 }
export function fetchStatusRedirect(code: int): bool { return code >= 300 && code <= 399 }
export function fetchStatusRetryable(code: int): bool {
    return code == 408 || code == 425 || code == 429 || code == 500 || code == 502 || code == 503 || code == 504
}
export function fetchRetryDelay(attempt: int): int {
    if attempt <= 0 { return 150 }
    if attempt == 1 { return 300 }
    if attempt == 2 { return 600 }
    if attempt == 3 { return 1200 }
    return 2500
}
export function fetchUrlHttps(url: []u8): bool {
    if len(url) < 9 as usize || len(url) > 4096 as usize { return false }
    let scheme: [u8; 8] = [104 as u8,116 as u8,116 as u8,112 as u8,115 as u8,58 as u8,47 as u8,47 as u8]
    let i: usize = 0 as usize
    while i < 8 as usize {
        if url[i] != scheme[i] { return false }
        i = i + 1 as usize
    }
    while i < len(url) {
        if url[i] <= 32 as u8 || url[i] == 92 as u8 || url[i] == 35 as u8 || url[i] == 64 as u8 { return false }
        i = i + 1 as usize
    }
    return true
}
export function fetchMaxResponseValid(bytes: usize): bool { return bytes <= 8388608 as usize }
export function fetchStartChecked(url: string): usize {
    if textLength(url) < 9 || textLength(url) > 4096 { return 0 as usize }
    return fetchStart(url)
}
export function fetchDone(handle: usize): bool {
    if !fetchHandleValid(handle) { return true }
    return fetchStatusDone(fetchStatus(handle))
}
export function fetchSuccessful(handle: usize): bool {
    if !fetchHandleValid(handle) { return false }
    return fetchStatusOk(fetchStatus(handle))
}
export function fetchTextIfSuccess(handle: usize): string {
    if !fetchSuccessful(handle) { return "" }
    return fetchText(handle)
}
export function fetchCancelIfActive(handle: usize): bool {
    if !fetchHandleValid(handle) || fetchDone(handle) { return false }
    return fetchCancel(handle)
}
