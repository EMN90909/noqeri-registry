import "../src/db.noqeri"
function main(): int {
let name: [u8; 5] = [116 as u8,97 as u8,98 as u8,108 as u8,101 as u8]
    let dst: [u8; 7] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    if dbQuoteIdentifier(slice(name),slice(dst)) != 7 as isize { return 1 }
    if dst[0] != 34 as u8 || dst[6] != 34 as u8 { return 2 }
    if dbTransactionValid(0,3) || !dbTransactionValid(1,3) { return 3 }
    if !dbRetryable(-5 as isize) || dbRetryable(-20 as isize) { return 4 }
    if dbExecuteIfValid(0 as usize,"SELECT 1") >= 0 as isize { return 5 }
    if !dbQuerySizeValid(500 as usize) || dbQuerySizeValid(0 as usize) { return 6 }
    return 0
}
print(main())
