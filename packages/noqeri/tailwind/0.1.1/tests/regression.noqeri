import "../src/tailwind.noqeri"
function main(): int {
let first: [u8; 4] = [102 as u8,108 as u8,101 as u8,120 as u8]
    let second: [u8; 4] = [103 as u8,97 as u8,112 as u8,45 as u8]
    let out: [u8; 9] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    if !tailwindClassValid(slice(first)) || tailwindJoinClasses(slice(first),slice(second),slice(out)) != 9 as isize { return 1 }
    let invalid: [u8; 2] = [91 as u8,93 as u8]
    if tailwindClassValid(slice(invalid)) { return 2 }
    let responsive: [u8; 7] = [109 as u8,100 as u8,58 as u8,102 as u8,108 as u8,101 as u8,120 as u8]
    if !tailwindResponsivePrefix(slice(responsive)) || tailwindVariantCount(slice(responsive)) != 1 as isize { return 3 }
    return 0
}
print(main())
