module noqeri.sentry

extern function providerHttpJson(method: string, url: string, authKind: string, authValue: string, headerName: string, headerValue: string, body: string): string
extern function providerHttpStatus(): int

export function sentryApiRoot(): string { return "https://sentry.io/api/0" }
export function sentryCredentialPresent(value: string): bool { return textLength(value) >= 8 }
export function sentryLastStatus(): int { return providerHttpStatus() }
export function sentryProjectsUrl(orgSlug: string): string { return sentryApiRoot() + "/organizations/" + orgSlug + "/projects/" }
export function sentryListProjects(token: string, orgSlug: string): string { if !sentryCredentialPresent(token) { return "" } return providerHttpJson("GET", sentryProjectsUrl(orgSlug), "bearer", token, "", "", "") }
