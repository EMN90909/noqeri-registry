// SPDX-License-Identifier: GPL-3.0-only
module noqeri.env

extern function envGet(name: string): string
extern function envHas(name: string): bool

export function envNameByteValid(value: u8): bool { return (value >= 65 as u8 && value <= 90 as u8) || (value >= 97 as u8 && value <= 122 as u8) || (value >= 48 as u8 && value <= 57 as u8) || value == 95 as u8 }
export function envNameValid(name: []u8): bool { if len(name) == 0 as usize { return false } let i: usize = 0 as usize while i < len(name) { if !envNameByteValid(name[i]) { return false } i = i + 1 } return true }

// REGISTRY_CAPABILITY_UPGRADE_V2
export function envAssignmentSeparator(value: []u8): isize {
    if len(value) == 0 as usize { return -1 as isize }
    let i: usize = 0 as usize
    while i < len(value) {
        if value[i] == 61 as u8 {
            if i == 0 as usize { return -1 as isize }
            return i as isize
        }
        if !envNameByteValid(value[i]) { return -1 as isize }
        i = i + 1 as usize
    }
    return -1 as isize
}
export function envValueSafe(value: []u8): bool {
    let i: usize = 0 as usize
    while i < len(value) {
        if value[i] == 0 as u8 || value[i] == 10 as u8 || value[i] == 13 as u8 { return false }
        i = i + 1 as usize
    }
    return true
}

// Supplemental MIT Noqeri implementations from 0.1.1; see LICENSE-MIT.

export function envInitialNameChar(c: u8): bool {
    return (c >= 65 as u8 && c <= 90 as u8) || (c >= 97 as u8 && c <= 122 as u8) || c == 95 as u8
}

export function envOtherNameChar(c: u8): bool { return envInitialNameChar(c) || (c >= 48 as u8 && c <= 57 as u8) }

export function envValueValid(data: []u8): bool {
    let i: usize = 0 as usize
    while i < len(data) {
        if data[i] == 0 as u8 || data[i] == 10 as u8 || data[i] == 13 as u8 { return false }
        i = i + 1 as usize
    }
    return true
}

export function envAssignmentValid(line: []u8): bool {
    let at: isize = envAssignmentSeparator(line)
    if at < 0 as isize { return false }
    let i: usize = (at as usize) + 1 as usize
    while i < len(line) {
        if line[i] == 0 as u8 || line[i] == 10 as u8 || line[i] == 13 as u8 { return false }
        i = i + 1 as usize
    }
    return true
}

export function envValueStart(line: []u8): isize {
    if !envAssignmentValid(line) { return -1 as isize }
    return envAssignmentSeparator(line) + 1 as isize
}

export function envNameCopy(line: []u8, dst: []u8): isize {
    let n: isize = envAssignmentSeparator(line)
    if n < 0 as isize || len(dst) < n as usize { return -1 as isize }
    let i: usize = 0 as usize
    while i < n as usize { dst[i] = line[i] i = i + 1 as usize }
    return n
}

export function envValueCopy(line: []u8, dst: []u8): isize {
    let begin: isize = envValueStart(line)
    if begin < 0 as isize { return -1 as isize }
    let bytes: usize = len(line) - begin as usize
    if bytes > len(dst) { return -1 as isize }
    let i: usize = 0 as usize
    while i < bytes { dst[i] = line[begin as usize + i] i = i + 1 as usize }
    return bytes as isize
}

export function envGetOr(name: string, fallback: string): string {
    if !envHas(name) { return fallback }
    return envGet(name)
}
