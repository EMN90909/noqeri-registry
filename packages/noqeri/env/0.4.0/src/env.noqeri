module noqeri.env

extern function envGet(name: string): string
extern function envHas(name: string): bool

export function envNameByteValid(value: u8): bool { return (value >= 65 as u8 && value <= 90 as u8) || (value >= 97 as u8 && value <= 122 as u8) || (value >= 48 as u8 && value <= 57 as u8) || value == 95 as u8 }
export function envNameValid(name: []u8): bool { if len(name) == 0 as usize { return false } let i: usize = 0 as usize while i < len(name) { if !envNameByteValid(name[i]) { return false } i = i + 1 } return true }

// REGISTRY_CAPABILITY_UPGRADE_V2
export function envAssignmentSeparator(value: []u8): isize {
    if len(value) == 0 as usize { return -1 as isize }
    let i: usize = 0 as usize
    while i < len(value) {
        if value[i] == 61 as u8 {
            if i == 0 as usize { return -1 as isize }
            return i as isize
        }
        if !envNameByteValid(value[i]) { return -1 as isize }
        i = i + 1 as usize
    }
    return -1 as isize
}
export function envValueSafe(value: []u8): bool {
    let i: usize = 0 as usize
    while i < len(value) {
        if value[i] == 0 as u8 || value[i] == 10 as u8 || value[i] == 13 as u8 { return false }
        i = i + 1 as usize
    }
    return true
}
