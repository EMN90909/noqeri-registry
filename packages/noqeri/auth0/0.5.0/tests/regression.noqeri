// All tests are network-independent; external transports require host integration.
import "../src/auth0.noqeri"
function main(): int {
    if !auth0StatusRetryable(429) || auth0StatusRetryable(404) { return 1 }
    if auth0RetryDelayMillis(0) != 200 || auth0RetryDelayMillis(8) != 5000 { return 2 }
    if !auth0PageValid(0,100) || auth0PageValid(-1,1) || auth0PageValid(0,101) { return 3 }
    if !(auth0UsersUrl("sample.us.auth0.com") == "https://sample.us.auth0.com/api/v2/users") { return 4 }
    if !(auth0RoleUsersUrl("sample.us.auth0.com","role_123") == "https://sample.us.auth0.com/api/v2/roles/role_123/users") { return 5 }
    let name: [u8; 5] = [114 as u8,111 as u8,108 as u8,101 as u8,49 as u8]
    let bad: [u8; 3] = [97 as u8,47 as u8,98 as u8]
    if !auth0IdentifierSafe(slice(name)) || auth0IdentifierSafe(slice(bad)) { return 6 }
    if !auth0MethodAllowed("PATCH") || auth0MethodAllowed("TRACE") { return 7 }
    return 0
}
print(main())
