module noqeri.toml
export function tomlBareKeyChar(value: u8): bool { return (value >= 65 as u8 && value <= 90 as u8) || (value >= 97 as u8 && value <= 122 as u8) || (value >= 48 as u8 && value <= 57 as u8) || value == 45 as u8 || value == 95 as u8 }
export function tomlDepthValid(depth: usize): bool { return depth <= 64 as usize }
export function tomlArrayLengthValid(count: usize): bool { return count <= 1000000 as usize }
export function tomlDocumentBytesValid(bytes: usize): bool { return bytes <= 16 as usize * 1024 as usize * 1024 as usize }

// REGISTRY_CAPABILITY_UPGRADE_V2
export function tomlBareKeyValid(value: []u8): bool {
    if len(value) == 0 as usize { return false }
    let i: usize = 0 as usize
    while i < len(value) { if !tomlBareKeyChar(value[i]) { return false } i = i + 1 as usize }
    return true
}
export function tomlIntegerTokenValid(value: []u8): bool {
    if len(value) == 0 as usize { return false }
    let i: usize = 0 as usize
    if value[0] == 45 as u8 || value[0] == 43 as u8 { i = 1 as usize }
    if i >= len(value) { return false }
    if value[i] == 48 as u8 && i + 1 as usize < len(value) { return false }
    while i < len(value) {
        if value[i] < 48 as u8 || value[i] > 57 as u8 { return false }
        i = i + 1 as usize
    }
    return true
}
