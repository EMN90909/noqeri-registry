module noqeri.postgres

// The provider host owns TLS, authentication and the PostgreSQL wire protocol.
// The Noqeri surface keeps native handles and FFI behind explicit unsafe blocks.
extern function postgresHostOpen(connection: string): usize
extern function postgresHostExec(connection: usize, sql: string): isize
extern function postgresHostQuery(connection: usize, sql: string): usize
extern function postgresHostRowsNext(rows: usize): bool
extern function postgresHostRowsColumnCount(rows: usize): usize
extern function postgresHostRowsText(rows: usize, column: usize): string
extern function postgresHostRowsClose(rows: usize): void
extern function postgresHostPrepare(connection: usize, name: string, sql: string): isize
extern function postgresHostExecPrepared(connection: usize, name: string, parametersJson: string): isize
extern function postgresHostQueryPrepared(connection: usize, name: string, parametersJson: string): usize
extern function postgresHostClose(connection: usize): bool

export function postgresHandleValid(connection: usize): bool { return connection != 0 as usize }
export function postgresRowsHandleValid(rows: usize): bool { return rows != 0 as usize }
export function postgresProtocolVersion(): int { return 196608 }
export function postgresDefaultPort(): int { return 5432 }
export function postgresMessageLengthValid(length: int): bool { return length >= 4 && length <= 16777216 }

export function postgresConnect(connection: string): usize {
    unsafe { return postgresHostOpen(connection) }
}

export function postgresExec(connection: usize, sql: string): isize {
    if !postgresHandleValid(connection) { return -1 }
    unsafe { return postgresHostExec(connection, sql) }
}

export function postgresQuery(connection: usize, sql: string): usize {
    if !postgresHandleValid(connection) { return 0 as usize }
    unsafe { return postgresHostQuery(connection, sql) }
}

export function postgresRowsNext(rows: usize): bool {
    if !postgresRowsHandleValid(rows) { return false }
    unsafe { return postgresHostRowsNext(rows) }
}

export function postgresRowsColumnCount(rows: usize): usize {
    if !postgresRowsHandleValid(rows) { return 0 as usize }
    unsafe { return postgresHostRowsColumnCount(rows) }
}

export function postgresRowsText(rows: usize, column: usize): string {
    if !postgresRowsHandleValid(rows) { return "" }
    unsafe { return postgresHostRowsText(rows, column) }
}

export function postgresRowsClose(rows: usize): void {
    if postgresRowsHandleValid(rows) {
        unsafe { postgresHostRowsClose(rows) }
    }
}

export function postgresPrepare(connection: usize, name: string, sql: string): isize {
    if !postgresHandleValid(connection) { return -1 }
    unsafe { return postgresHostPrepare(connection, name, sql) }
}

export function postgresExecPrepared(connection: usize, name: string, parametersJson: string): isize {
    if !postgresHandleValid(connection) { return -1 }
    unsafe { return postgresHostExecPrepared(connection, name, parametersJson) }
}

export function postgresQueryPrepared(connection: usize, name: string, parametersJson: string): usize {
    if !postgresHandleValid(connection) { return 0 as usize }
    unsafe { return postgresHostQueryPrepared(connection, name, parametersJson) }
}

export function postgresBegin(connection: usize): isize { return postgresExec(connection, "BEGIN") }
export function postgresCommit(connection: usize): isize { return postgresExec(connection, "COMMIT") }
export function postgresRollback(connection: usize): isize { return postgresExec(connection, "ROLLBACK") }

export function postgresClose(connection: usize): bool {
    if !postgresHandleValid(connection) { return false }
    unsafe { return postgresHostClose(connection) }
}
