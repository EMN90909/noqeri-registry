module noqeri.test

export function assertTrue(value: bool): isize { if value { return 0 } return -1 }
export function assertFalse(value: bool): isize { if value { return -1 } return 0 }
export function assertIntEqual(actual: int, expected: int): isize { if actual == expected { return 0 } return -1 }
export function assertUsizeEqual(actual: usize, expected: usize): isize { if actual == expected { return 0 } return -1 }

// REGISTRY_CAPABILITY_UPGRADE_V2
export function assert_bool(actual: bool, expected: bool): isize {
    if actual && !expected { return -1 as isize }
    if !actual && expected { return -1 as isize }
    return 0 as isize
}
export function assert_u64(actual: u64, expected: u64): isize {
    if actual != expected { return -1 as isize }
    return 0 as isize
}
export function assert_bytes_equal(left: []u8, right: []u8): isize {
    if len(left) != len(right) { return -1 as isize }
    let i: usize = 0 as usize
    while i < len(left) { if left[i] != right[i] { return -1 as isize } i = i + 1 as usize }
    return 0 as isize
}
