module noqeri.test

export function assert_i64(actual: i64, expected: i64): isize {
    if actual != expected {
        throw 1
    }
    return 0
}

// REGISTRY_CAPABILITY_UPGRADE_V2
export function assert_bool(actual: bool, expected: bool): isize {
    if actual && !expected { return -1 as isize }
    if !actual && expected { return -1 as isize }
    return 0 as isize
}
export function assert_u64(actual: u64, expected: u64): isize {
    if actual != expected { return -1 as isize }
    return 0 as isize
}
export function assert_bytes_equal(left: []u8, right: []u8): isize {
    if len(left) != len(right) { return -1 as isize }
    let i: usize = 0 as usize
    while i < len(left) { if left[i] != right[i] { return -1 as isize } i = i + 1 as usize }
    return 0 as isize
}

// Native Noqeri v0.5.0 additions.
export function assert_string_equal(actual: string, expected: string): isize {
 if actual == expected { return 0 as isize }
 return -1 as isize
}
export function assert_bytes_prefix(value: []u8, prefix: []u8): isize {
 if len(prefix) > len(value) { return -1 as isize }
 let i: usize = 0 as usize
 while i < len(prefix) {
  if value[i] != prefix[i] { return -1 as isize }
  i = i + 1 as usize
 }
 return 0 as isize
}
export function assert_length_between(length: usize, minimum: usize, maximum: usize): isize {
 if minimum > maximum || length < minimum || length > maximum { return -1 as isize }
 return 0 as isize
}
export function assert_i64_range(value: i64, minimum: i64, maximum: i64): isize {
 if minimum > maximum || value < minimum || value > maximum { return -1 as isize }
 return 0 as isize
}
