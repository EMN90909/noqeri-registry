module noqeri.dom

extern function domFind(selector: string): usize
extern function domSetText(node: usize, text: string): bool
extern function domSetAttribute(node: usize, name: string, value: string): bool
extern function domRemove(node: usize): bool

export function domHandleValid(node: usize): bool { return node != 0 as usize }
export function domSetTextIfPresent(node: usize, text: string): bool { if !domHandleValid(node) { return false } return domSetText(node, text) }
