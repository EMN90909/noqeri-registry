import "../src/dom.noqeri"
function main(): int {
let good: [u8; 4] = [109 as u8,97 as u8,105 as u8,110 as u8]
    let bad: [u8; 3] = [49 as u8,97 as u8,98 as u8]
    if !domCssIdValid(slice(good)) || domCssIdValid(slice(bad)) { return 1 }
    let title: [u8; 5] = [116 as u8,105 as u8,116 as u8,108 as u8,101 as u8]
    let click: [u8; 7] = [111 as u8,110 as u8,99 as u8,108 as u8,105 as u8,99 as u8,107 as u8]
    if !domAttributeAllowed(slice(title)) || domAttributeAllowed(slice(click)) { return 2 }
    if domSetTextChecked(0 as usize,"Hi") { return 3 }
    if !domTagValid(slice(good)) || domTagValid(slice(bad)) { return 4 }
    return 0
}
print(main())
