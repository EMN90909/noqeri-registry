module noqeri.base64

export function base64EncodedLength(bytes: usize): usize { return ((bytes + 2 as usize) / 3 as usize) * 4 as usize }
export function base64DecodedMaxLength(chars: usize): usize { return (chars / 4 as usize) * 3 as usize }

export function base64AlphabetValue(value: u8): int {
    if value >= 65 as u8 && value <= 90 as u8 { return (value - 65 as u8) as int }
    if value >= 97 as u8 && value <= 122 as u8 { return (value - 97 as u8) as int + 26 }
    if value >= 48 as u8 && value <= 57 as u8 { return (value - 48 as u8) as int + 52 }
    if value == 43 as u8 { return 62 }
    if value == 47 as u8 { return 63 }
    return -1
}

export function base64UrlAlphabetValue(value: u8): int {
    if value == 45 as u8 { return 62 }
    if value == 95 as u8 { return 63 }
    if value == 43 as u8 || value == 47 as u8 { return -1 }
    return base64AlphabetValue(value)
}

export function base64Digit(value: u8): u8 {
    if value < 26 as u8 { return 65 as u8 + value }
    if value < 52 as u8 { return 97 as u8 + (value - 26 as u8) }
    if value < 62 as u8 { return 48 as u8 + (value - 52 as u8) }
    if value == 62 as u8 { return 43 as u8 }
    if value == 63 as u8 { return 47 as u8 }
    return 63 as u8
}

export function base64UrlDigit(value: u8): u8 {
    if value == 62 as u8 { return 45 as u8 }
    if value == 63 as u8 { return 95 as u8 }
    return base64Digit(value)
}

export function base64CharValid(value: u8): bool { return base64AlphabetValue(value) >= 0 || value == 61 as u8 }
export function base64UrlCharValid(value: u8): bool { return base64UrlAlphabetValue(value) >= 0 || value == 61 as u8 }
export function base64LengthValid(chars: usize): bool { return chars % 4 as usize == 0 as usize }

export function base64Valid(value: []u8): bool {
    if len(value) == 0 as usize { return true }
    if !base64LengthValid(len(value)) { return false }
    let i: usize = 0 as usize
    while i < len(value) {
        let c: u8 = value[i]
        if !base64CharValid(c) { return false }
        if c == 61 as u8 && i + 2 as usize < len(value) { return false }
        i = i + 1 as usize
    }
    if len(value) >= 2 as usize && value[len(value) - 2 as usize] == 61 as u8 && value[len(value) - 1 as usize] != 61 as u8 { return false }
    return true
}

export function base64UrlValid(value: []u8, padded: bool): bool {
    if padded && len(value) % 4 as usize != 0 as usize { return false }
    if !padded && len(value) % 4 as usize == 1 as usize { return false }
    let seenPadding: bool = false
    let paddingCount: usize = 0 as usize
    let i: usize = 0 as usize
    while i < len(value) {
        let c: u8 = value[i]
        if c == 61 as u8 {
            if !padded || i + 2 as usize < len(value) { return false }
            seenPadding = true
            paddingCount = paddingCount + 1 as usize
            if paddingCount > 2 as usize { return false }
        } else {
            if seenPadding || base64UrlAlphabetValue(c) < 0 { return false }
        }
        i = i + 1 as usize
    }
    if paddingCount == 1 as usize && len(value) >= 1 as usize && len(value) % 4 as usize != 0 as usize { return false }
    return true
}

export function base64DecodedLength(value: []u8): isize {
    if !base64Valid(value) { return -1 as isize }
    if len(value) == 0 as usize { return 0 as isize }
    let padding: usize = 0 as usize
    if value[len(value) - 1 as usize] == 61 as u8 { padding = padding + 1 as usize }
    if value[len(value) - 2 as usize] == 61 as u8 { padding = padding + 1 as usize }
    return ((len(value) / 4 as usize) * 3 as usize - padding) as isize
}

export function base64Encode(source: []u8, destination: []u8): isize {
    let required: usize = base64EncodedLength(len(source))
    if len(destination) < required { return -1 as isize }
    let input: usize = 0 as usize
    let output: usize = 0 as usize
    while input < len(source) {
        let remaining: usize = len(source) - input
        let first: u32 = source[input] as u32
        let second: u32 = 0 as u32
        let third: u32 = 0 as u32
        if remaining > 1 as usize { second = source[input + 1 as usize] as u32 }
        if remaining > 2 as usize { third = source[input + 2 as usize] as u32 }
        let combined: u32 = first * 65536 as u32 + second * 256 as u32 + third
        destination[output] = base64Digit((combined / 262144 as u32) as u8)
        destination[output + 1 as usize] = base64Digit(((combined / 4096 as u32) % 64 as u32) as u8)
        if remaining > 1 as usize { destination[output + 2 as usize] = base64Digit(((combined / 64 as u32) % 64 as u32) as u8) } else { destination[output + 2 as usize] = 61 as u8 }
        if remaining > 2 as usize { destination[output + 3 as usize] = base64Digit((combined % 64 as u32) as u8) } else { destination[output + 3 as usize] = 61 as u8 }
        input = input + 3 as usize
        output = output + 4 as usize
    }
    return output as isize
}

export function base64EncodeUrl(source: []u8, destination: []u8, padding: bool): isize {
    let full: usize = base64EncodedLength(len(source))
    let required: usize = full
    if !padding {
        let remainder: usize = len(source) % 3 as usize
        if remainder == 1 as usize { required = full - 2 as usize }
        if remainder == 2 as usize { required = full - 1 as usize }
    }
    if len(destination) < required { return -1 as isize }
    let input: usize = 0 as usize
    let output: usize = 0 as usize
    while input < len(source) {
        let remaining: usize = len(source) - input
        let first: u32 = source[input] as u32
        let second: u32 = 0 as u32
        let third: u32 = 0 as u32
        if remaining > 1 as usize { second = source[input + 1 as usize] as u32 }
        if remaining > 2 as usize { third = source[input + 2 as usize] as u32 }
        let combined: u32 = first * 65536 as u32 + second * 256 as u32 + third
        destination[output] = base64UrlDigit((combined / 262144 as u32) as u8)
        output = output + 1 as usize
        destination[output] = base64UrlDigit(((combined / 4096 as u32) % 64 as u32) as u8)
        output = output + 1 as usize
        if remaining > 1 as usize { destination[output] = base64UrlDigit(((combined / 64 as u32) % 64 as u32) as u8) output = output + 1 as usize } else if padding { destination[output] = 61 as u8 output = output + 1 as usize }
        if remaining > 2 as usize { destination[output] = base64UrlDigit((combined % 64 as u32) as u8) output = output + 1 as usize } else if padding { destination[output] = 61 as u8 output = output + 1 as usize }
        input = input + 3 as usize
    }
    return output as isize
}

function base64DecodeValue(c: u8, url: bool): int {
    if url { return base64UrlAlphabetValue(c) }
    return base64AlphabetValue(c)
}

export function base64Decode(source: []u8, destination: []u8): isize {
    let required: isize = base64DecodedLength(source)
    if required < 0 as isize || required as usize > len(destination) { return -1 as isize }
    let input: usize = 0 as usize
    let output: usize = 0 as usize
    while input < len(source) {
        let a: int = base64AlphabetValue(source[input])
        let b: int = base64AlphabetValue(source[input + 1 as usize])
        let c: int = 0
        let d: int = 0
        if source[input + 2 as usize] != 61 as u8 { c = base64AlphabetValue(source[input + 2 as usize]) }
        if source[input + 3 as usize] != 61 as u8 { d = base64AlphabetValue(source[input + 3 as usize]) }
        if a < 0 || b < 0 || c < 0 || d < 0 { return -1 as isize }
        let combined: u32 = a as u32 * 262144 as u32 + b as u32 * 4096 as u32 + c as u32 * 64 as u32 + d as u32
        destination[output] = (combined / 65536 as u32) as u8
        output = output + 1 as usize
        if source[input + 2 as usize] != 61 as u8 { destination[output] = ((combined / 256 as u32) % 256 as u32) as u8 output = output + 1 as usize }
        if source[input + 3 as usize] != 61 as u8 { destination[output] = (combined % 256 as u32) as u8 output = output + 1 as usize }
        input = input + 4 as usize
    }
    return output as isize
}

export function base64DecodeUrl(source: []u8, destination: []u8): isize {
    if !base64UrlValid(source, false) && !base64UrlValid(source, true) { return -1 as isize }
    let output: usize = 0 as usize
    let input: usize = 0 as usize
    while input < len(source) {
        let remaining: usize = len(source) - input
        if remaining < 2 as usize { return -1 as isize }
        let a: int = base64DecodeValue(source[input], true)
        let b: int = base64DecodeValue(source[input + 1 as usize], true)
        if a < 0 || b < 0 { return -1 as isize }
        let c: int = 0
        let d: int = 0
        let has_c: bool = remaining > 2 as usize && source[input + 2 as usize] != 61 as u8
        let has_d: bool = remaining > 3 as usize && source[input + 3 as usize] != 61 as u8
        if has_c { c = base64DecodeValue(source[input + 2 as usize], true) if c < 0 { return -1 as isize } }
        if has_d { d = base64DecodeValue(source[input + 3 as usize], true) if d < 0 { return -1 as isize } }
        let combined: u32 = a as u32 * 262144 as u32 + b as u32 * 4096 as u32 + c as u32 * 64 as u32 + d as u32
        if output >= len(destination) { return -1 as isize }
        destination[output] = (combined / 65536 as u32) as u8
        output = output + 1 as usize
        if has_c { if output >= len(destination) { return -1 as isize } destination[output] = ((combined / 256 as u32) % 256 as u32) as u8 output = output + 1 as usize }
        if has_d { if output >= len(destination) { return -1 as isize } destination[output] = (combined % 256 as u32) as u8 output = output + 1 as usize }
        input = input + 4 as usize
    }
    return output as isize
}

// MIT-licensed complementary implementations brought forward from v0.1.1.
export function base64EncodedUrlLength(inputBytes: usize, padded: bool): usize {
    if padded { return base64EncodedLength(inputBytes) }
    let result: usize = (inputBytes / 3 as usize) * 4 as usize
    if inputBytes % 3 as usize == 1 as usize { result = result + 2 as usize }
    if inputBytes % 3 as usize == 2 as usize { result = result + 3 as usize }
    return result
}

export function base64ValidateMode(input: []u8, url: bool, padded: bool): bool {
    let n: usize = len(input)
    if n == 0 as usize { return true }
    if n % 4 as usize == 1 as usize { return false }
    if padded && n % 4 as usize != 0 as usize { return false }
    let pad: usize = 0 as usize
    let seenPad: bool = false
    let i: usize = 0 as usize
    while i < n {
        let c: u8 = input[i]
        if c == 61 as u8 {
            if !padded { return false }
            if i + 2 as usize < n { return false }
            seenPad = true
            pad = pad + 1 as usize
        } else {
            if seenPad || base64Value(c,url) < 0 { return false }
        }
        i = i + 1 as usize
    }
    if pad > 2 as usize { return false }
    if pad > 0 as usize && n % 4 as usize != 0 as usize { return false }
    if n - pad < 2 as usize { return false }
    let last: int = base64Value(input[n - pad - 1 as usize],url)
    if pad == 2 as usize || (!padded && n % 4 as usize == 2 as usize) { return last % 16 == 0 }
    if pad == 1 as usize || (!padded && n % 4 as usize == 3 as usize) { return last % 4 == 0 }
    return true
}

export function base64DecodedLengthMode(input: []u8, url: bool, padded: bool): isize {
    if !base64ValidateMode(input,url,padded) { return -1 as isize }
    let pad: usize = 0 as usize
    let n: usize = len(input)
    if n >= 1 as usize && input[n - 1 as usize] == 61 as u8 { pad = pad + 1 as usize }
    if n >= 2 as usize && input[n - 2 as usize] == 61 as u8 { pad = pad + 1 as usize }
    return (base64DecodedMaxLength(n) - pad) as isize
}

export function base64DecodedUrlLength(input: []u8, padded: bool): isize {
    return base64DecodedLengthMode(input,true,padded)
}

export function base64EncodeMode(src: []u8, dst: []u8, url: bool, padded: bool): isize {
    let required: usize = base64EncodedUrlLength(len(src),padded)
    if len(dst) < required { return -1 as isize }
    let i: usize = 0 as usize
    let output: usize = 0 as usize
    while i < len(src) {
        let remaining: usize = len(src) - i
        let a: u32 = src[i] as u32
        let b: u32 = 0 as u32
        let c: u32 = 0 as u32
        if remaining > 1 as usize { b = src[i + 1 as usize] as u32 }
        if remaining > 2 as usize { c = src[i + 2 as usize] as u32 }
        let x: u32 = a * 65536 as u32 + b * 256 as u32 + c
        let d1: u8 = (x / 262144 as u32) as u8
        let d2: u8 = ((x / 4096 as u32) % 64 as u32) as u8
        let d3: u8 = ((x / 64 as u32) % 64 as u32) as u8
        let d4: u8 = (x % 64 as u32) as u8
        if url {
            dst[output] = base64UrlDigit(d1)
            dst[output + 1 as usize] = base64UrlDigit(d2)
        } else {
            dst[output] = base64Digit(d1)
            dst[output + 1 as usize] = base64Digit(d2)
        }
        output = output + 2 as usize
        if remaining > 1 as usize {
            if url { dst[output] = base64UrlDigit(d3) } else { dst[output] = base64Digit(d3) }
            output = output + 1 as usize
        } else if padded { dst[output] = 61 as u8 output = output + 1 as usize }
        if remaining > 2 as usize {
            if url { dst[output] = base64UrlDigit(d4) } else { dst[output] = base64Digit(d4) }
            output = output + 1 as usize
        } else if padded { dst[output] = 61 as u8 output = output + 1 as usize }
        i = i + 3 as usize
    }
    return output as isize
}

export function base64DecodeMode(src: []u8, dst: []u8, url: bool, padded: bool): isize {
    let required: isize = base64DecodedLengthMode(src,url,padded)
    if required < 0 as isize || len(dst) < required as usize { return -1 as isize }
    let i: usize = 0 as usize
    let out: usize = 0 as usize
    while i < len(src) {
        let a: int = base64Value(src[i],url)
        let b: int = base64Value(src[i + 1 as usize],url)
        let c: int = 0
        let d: int = 0
        let hasC: bool = i + 2 as usize < len(src) && src[i + 2 as usize] != 61 as u8
        let hasD: bool = i + 3 as usize < len(src) && src[i + 3 as usize] != 61 as u8
        if hasC { c = base64Value(src[i + 2 as usize],url) }
        if hasD { d = base64Value(src[i + 3 as usize],url) }
        let x: u32 = a as u32 * 262144 as u32 + b as u32 * 4096 as u32 + c as u32 * 64 as u32 + d as u32
        dst[out] = (x / 65536 as u32) as u8
        out = out + 1 as usize
        if hasC {
            dst[out] = ((x / 256 as u32) % 256 as u32) as u8
            out = out + 1 as usize
        }
        if hasD {
            dst[out] = (x % 256 as u32) as u8
            out = out + 1 as usize
        }
        i = i + 4 as usize
    }
    return out as isize
}
