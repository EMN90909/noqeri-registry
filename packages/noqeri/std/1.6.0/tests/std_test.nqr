import "../src/std.nqr"

function main(): int {
    if std_version_major() != 1 || std_version_minor() != 6 { return 1 }
    if std_module_floor() < 100 as usize || !std_aggregate_generics() || !std_safe_collections_default() || !std_try_status_model() { return 2 }
    if std_encode_error(7 as isize) != -8 as isize { return 3 }
    if std_checked_error_code(-8 as isize) != 7 as isize { return 4 }
    if !std_index_valid(2 as usize, 3 as usize) || std_index_valid(3 as usize, 3 as usize) { return 5 }
    if !std_range_valid(3 as usize, 4 as usize, 7 as usize) || std_range_valid(5 as usize, 3 as usize, 7 as usize) { return 6 }
    if !std_aes_key_bits_valid(256 as usize) || std_aes_key_bits_valid(512 as usize) { return 7 }
    if !std_rsa_key_bits_valid(3072 as usize) || std_rsa_key_bits_valid(1024 as usize) { return 8 }

    let values: [i64; 6] = [4 as i64,7 as i64,7 as i64,9 as i64,7 as i64,12 as i64]
    if !std_generic_contains(slice(values), 9 as i64) { return 9 }
    if std_generic_count(slice(values), 7 as i64) != 3 as usize { return 10 }
    if std_generic_first_index(slice(values), 7 as i64) != 1 as isize { return 11 }
    let same: [i64; 6] = [4 as i64,7 as i64,7 as i64,9 as i64,7 as i64,12 as i64]
    let other: [i64; 2] = [4 as i64,7 as i64]
    if !std_generic_slice_equal(slice(values), slice(same)) { return 12 }
    if std_generic_slice_equal(slice(values), slice(other)) { return 13 }

    let sum: usize = 0 as usize
    if !std_checked_add_usize(20 as usize, 22 as usize, &sum) || sum != 42 as usize { return 14 }
    let product: usize = 0 as usize
    if !std_checked_mul_usize(6 as usize, 7 as usize, &product) || product != 42 as usize { return 15 }

    return 0
}
