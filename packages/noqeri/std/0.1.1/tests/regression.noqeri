import "../src/std.noqeri"
function main(): int {
let bytes: [u8; 3] = [49 as u8,50 as u8,51 as u8]
    let parsed: [u64; 1] = [0 as u64]
    if !stdParseU64(slice(bytes),slice(parsed)) || parsed[0] != 123 as u64 { return 1 }
    let out: [u8; 3] = [0 as u8,0 as u8,0 as u8]
    if stdFormatU64(parsed[0],slice(out)) != 3 as isize || !stdBytesEqual(slice(bytes),slice(out)) { return 2 }
    if !stdRangeValid(1 as usize,2 as usize,3 as usize) || stdRangeValid(3 as usize,1 as usize,3 as usize) { return 3 }
    return 0
}
print(main())
