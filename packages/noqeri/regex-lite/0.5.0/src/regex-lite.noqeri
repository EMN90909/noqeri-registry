module noqeri.regex_lite
export function regexPatternBytesValid(bytes: usize): bool { return bytes > 0 as usize && bytes <= 65536 as usize }
export function regexCaptureCountValid(count: usize): bool { return count <= 128 as usize }
export function regexRepeatValid(minimum: usize, maximum: usize): bool { return minimum <= maximum && maximum <= 1000000 as usize }
export function regexMeta(value: u8): bool { return value == 46 as u8 || value == 42 as u8 || value == 43 as u8 || value == 63 as u8 || value == 40 as u8 || value == 41 as u8 || value == 91 as u8 || value == 93 as u8 || value == 123 as u8 || value == 125 as u8 || value == 94 as u8 || value == 36 as u8 || value == 124 as u8 }

// REGISTRY_CAPABILITY_UPGRADE_V2
export function regexLiteralOnly(pattern: []u8): bool {
    if !regexPatternBytesValid(len(pattern)) { return false }
    let i: usize = 0 as usize
    while i < len(pattern) {
        if regexMeta(pattern[i]) || pattern[i] == 92 as u8 { return false }
        i = i + 1 as usize
    }
    return true
}
export function regexLiteralFind(haystack: []u8, needle: []u8): isize {
    if len(needle) == 0 as usize { return 0 as isize }
    if len(needle) > len(haystack) { return -1 as isize }
    let start: usize = 0 as usize
    while start <= len(haystack) - len(needle) {
        let i: usize = 0 as usize
        while i < len(needle) && haystack[start + i] == needle[i] { i = i + 1 as usize }
        if i == len(needle) { return start as isize }
        start = start + 1 as usize
    }
    return -1 as isize
}

// v0.5.0: substantive pure-Noqeri implementation.
export function regexTinyFullMatch(pattern: []u8, text: []u8, previous: []u8, current: []u8): int {
 if len(pattern) > 256 as usize || len(text) > 4096 as usize { return -1 }
 if len(previous) <= len(text) || len(current) <= len(text) { return -2 }
 let j: usize = 0 as usize
 while j <= len(text) {
  previous[j] = 0 as u8
  current[j] = 0 as u8
  j = j + 1 as usize
 }
 previous[0] = 1 as u8
 let p: usize = 0 as usize
 while p < len(pattern) {
  let atom: u8 = pattern[p]
  let wildcard: bool = atom == 46 as u8
  if atom == 42 as u8 || atom == 63 as u8 || atom == 43 as u8 || atom == 91 as u8 || atom == 40 as u8 || atom == 124 as u8 || atom == 94 as u8 || atom == 36 as u8 { return -1 }
  if atom == 92 as u8 {
   p = p + 1 as usize
   if p >= len(pattern) { return -1 }
   atom = pattern[p]
  }
  let quantifier: u8 = 0 as u8
  if p + 1 as usize < len(pattern) {
   if pattern[p + 1 as usize] == 42 as u8 || pattern[p + 1 as usize] == 63 as u8 {
    quantifier = pattern[p + 1 as usize]
    p = p + 1 as usize
   }
  }
  current[0] = 0 as u8
  if quantifier == 42 as u8 || quantifier == 63 as u8 { current[0] = previous[0] }
  j = 1 as usize
  while j <= len(text) {
   let matches: bool = wildcard || text[j - 1 as usize] == atom
   let ok: bool = false
   if quantifier == 42 as u8 { ok = previous[j] != 0 as u8 || (matches && current[j - 1 as usize] != 0 as u8) }
   else if quantifier == 63 as u8 { ok = previous[j] != 0 as u8 || (matches && previous[j - 1 as usize] != 0 as u8) }
   else { ok = matches && previous[j - 1 as usize] != 0 as u8 }
   if ok { current[j] = 1 as u8 } else { current[j] = 0 as u8 }
   j = j + 1 as usize
  }
  j = 0 as usize
  while j <= len(text) {
   previous[j] = current[j]
   j = j + 1 as usize
  }
  p = p + 1 as usize
 }
 if previous[len(text)] != 0 as u8 { return 1 }
 return 0
}
