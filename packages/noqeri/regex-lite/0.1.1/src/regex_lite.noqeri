module noqeri.regex_lite
export function regexLiteralEqual(a: []u8, b: []u8): bool {
    if len(a) != len(b) { return false }
    let i: usize = 0 as usize
    while i < len(a) { if a[i] != b[i] { return false } i = i + 1 as usize }
    return true
}
export function regexStartsWith(value: []u8, prefix: []u8): bool {
    if len(prefix) > len(value) { return false }
    let i: usize = 0 as usize
    while i < len(prefix) { if value[i] != prefix[i] { return false } i = i + 1 as usize }
    return true
}
export function regexEndsWith(value: []u8, suffix: []u8): bool {
    if len(suffix) > len(value) { return false }
    let start: usize = len(value) - len(suffix)
    let i: usize = 0 as usize
    while i < len(suffix) { if value[start + i] != suffix[i] { return false } i = i + 1 as usize }
    return true
}
export function regexFindLiteral(value: []u8, needle: []u8): isize {
    if len(needle) == 0 as usize { return 0 as isize }
    if len(needle) > len(value) { return -1 as isize }
    let i: usize = 0 as usize
    while i <= len(value) - len(needle) {
        let j: usize = 0 as usize
        while j < len(needle) && value[i + j] == needle[j] { j = j + 1 as usize }
        if j == len(needle) { return i as isize }
        i = i + 1 as usize
    }
    return -1 as isize
}
export function regexWildcardMatch(pattern: []u8, value: []u8): bool {
    let i: usize = 0 as usize
    let j: usize = 0 as usize
    let star: usize = len(pattern)
    let restart: usize = 0 as usize
    while j < len(value) {
        if i < len(pattern) && (pattern[i] == value[j] || pattern[i] == 63 as u8) {
            i = i + 1 as usize
            j = j + 1 as usize
        } else if i < len(pattern) && pattern[i] == 42 as u8 {
            star = i
            restart = j
            i = i + 1 as usize
        } else if star < len(pattern) {
            restart = restart + 1 as usize
            j = restart
            i = star + 1 as usize
        } else { return false }
    }
    while i < len(pattern) && pattern[i] == 42 as u8 { i = i + 1 as usize }
    return i == len(pattern)
}
export function regexWildcardCount(pattern: []u8): usize {
    let n: usize = 0 as usize
    let i: usize = 0 as usize
    while i < len(pattern) {
        if pattern[i] == 42 as u8 || pattern[i] == 63 as u8 { n = n + 1 as usize }
        i = i + 1 as usize
    }
    return n
}
export function regexInputBounded(pattern: usize, value: usize): bool { return pattern <= 4096 as usize && value <= 1048576 as usize }
