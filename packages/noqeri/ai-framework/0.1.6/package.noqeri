// SPDX-License-Identifier: Apache-2.0
// Optional umbrella bundle: pure Noqeri AI modules are independent packages.
package {
 name: "noqeri/ai-framework"
 version: "0.1.6"
 edition: "2026"
 entry: "src/framework.noqeri"
 profile: "library"
 target: "portable"
 license: "Apache-2.0"
}
dependencies {
 tensor: "noqeri/ai-tensor@0.1.0"
 nn: "noqeri/ai-nn@0.1.0"
 optim: "noqeri/ai-optim@0.1.0"
 autodiff: "noqeri/ai-autodiff@0.1.0"
 tokenizer: "noqeri/ai-tokenizer@0.1.0"
 evaluation: "noqeri/ai-eval@0.1.0"
 agent: "noqeri/ai-agent@0.1.0"
 vector: "noqeri/ai-vector@0.1.0"
 data: "noqeri/ai-data@0.1.0"
}
