import "../src/pgas.noqeri"
function main(): int {
if pgasBlockStart(10 as usize,3 as usize,1 as usize) != 4 as usize { return 1 }
    if pgasBlockLength(10 as usize,3 as usize,2 as usize) != 3 as usize { return 2 }
    if pgasBlockOwner(10 as usize,3 as usize,8 as usize) != 2 as isize { return 3 }
    if pgasCyclicOwner(8 as usize,3 as usize) != 2 as isize { return 4 }
    if pgasLocalOffset(10 as usize,3 as usize,1 as usize,5 as usize) != 1 as isize { return 5 }
    if pgasBlockOwner(0 as usize,3 as usize,0 as usize) >= 0 as isize { return 6 }
    return 0
}
print(main())
