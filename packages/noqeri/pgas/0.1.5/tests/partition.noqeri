import "../src/pgas.noqeri"
function main(): int {
 if !pgas_partition_valid(8 as u64,2 as u32,pgas_block()) { return 1 }
 if pgas_local_slot_count(10 as u64,3 as u32,0 as u32,pgas_block()) != 4 as u64 { return 2 }
 if pgas_local_slot_count(10 as u64,3 as u32,2 as u32,pgas_block()) != 3 as u64 { return 3 }
 if pgas_local_slot_count(10 as u64,3 as u32,0 as u32,pgas_cyclic()) != 4 as u64 { return 4 }
 if pgas_local_slot_count(10 as u64,3 as u32,2 as u32,pgas_cyclic()) != 3 as u64 { return 5 }
 if !pgas_local_slot_index_valid(10 as u64,3 as u32,1 as u32,pgas_block(),2 as u64) { return 6 }
 if pgas_local_slot_index_valid(10 as u64,3 as u32,1 as u32,pgas_block(),3 as u64) { return 7 }
 if !pgas_sandbox_bounds_valid(32 as usize,2048 as u32) { return 8 }
 return 0
}
print(main())
