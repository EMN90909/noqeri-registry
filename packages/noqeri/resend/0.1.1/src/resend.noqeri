// Explicit host boundary: this module is an API adapter, not a bundled HTTP stack.
module noqeri.resend
extern function providerHttpJson(method: string, url: string, authKind: string, authValue: string, headerName: string, headerValue: string, body: string): string
extern function providerHttpStatus(): int
export function resendRoot(): string { return "https://api.resend.com" }
export function resendStatus(): int { return providerHttpStatus() }
export function resendSuccess(code: int): bool { return code >= 200 && code < 300 }
export function resendRateLimited(code: int): bool { return code == 429 }
export function resendRetryable(code: int): bool { return code == 408 || code == 423 || code == 429 || code == 500 || code == 502 || code == 503 || code == 504 }
export function resendMethodAllowed(method: string): bool { return method == "GET" || method == "POST" || method == "PATCH" || method == "PUT" || method == "DELETE" }
export function resendCredentialValid(token: string): bool { return textLength(token) >= 8 && textLength(token) <= 8192 }
export function resendBodyValid(size: usize): bool { return size <= 1048576 as usize }
export function resendPageSizeValid(size: int): bool { return size > 0 && size <= 100 }
export function resendIdentifierChar(c: u8): bool {
    return (c >= 65 as u8 && c <= 90 as u8) || (c >= 97 as u8 && c <= 122 as u8) || (c >= 48 as u8 && c <= 57 as u8) || c == 45 as u8 || c == 95 as u8 || c == 46 as u8
}
export function resendIdentifierValid(id: []u8): bool {
    if len(id) == 0 as usize || len(id) > 128 as usize { return false }
    if len(id) == 1 as usize && id[0] == 46 as u8 { return false }
    if len(id) == 2 as usize && id[0] == 46 as u8 && id[1] == 46 as u8 { return false }
    let i: usize = 0 as usize
    while i < len(id) { if !resendIdentifierChar(id[i]) { return false } i = i + 1 as usize }
    return true
}
export function resendDelayMillis(attempt: int): int {
    if attempt <= 0 { return 200 }
    if attempt == 1 { return 400 }
    if attempt == 2 { return 800 }
    if attempt == 3 { return 1600 }
    return 3200
}
export function resendRequest(method: string, token: string, url: string, body: string): string {
    if !resendMethodAllowed(method) || !resendCredentialValid(token) || textLength(url) < 10 || textLength(body) > 1048576 { return "" }
    return providerHttpJson(method,url,"bearer",token,"Accept","application/json",body)
}
export function resendEmailsUrl(): string { return resendRoot() + "/emails" }
export function resendDomainsUrl(): string { return resendRoot() + "/domains" }
export function resendApiKeysUrl(): string { return resendRoot() + "/api-keys" }
export function resendContactsUrl(): string { return resendRoot() + "/contacts" }
export function resendBroadcastsUrl(): string { return resendRoot() + "/broadcasts" }
export function resendAudiencesUrl(): string { return resendRoot() + "/audiences" }
export function resendTemplatesUrl(): string { return resendRoot() + "/templates" }
export function resendWebhooksUrl(): string { return resendRoot() + "/webhooks" }
export function resendEmailUrl(id: string): string { return resendRoot() + "/emails/" + id }
export function resendDomainUrl(id: string): string { return resendRoot() + "/domains/" + id }
export function resendGet(token: string, url: string): string { return resendRequest("GET",token,url,"") }
export function resendPost(token: string, url: string, body: string): string { return resendRequest("POST",token,url,body) }
export function resendPatch(token: string, url: string, body: string): string { return resendRequest("PATCH",token,url,body) }
export function resendDelete(token: string, url: string): string { return resendRequest("DELETE",token,url,"") }
export function resendEmailShape(address: []u8): bool {
    if len(address) < 3 as usize || len(address) > 254 as usize { return false }
    let at: usize = 0 as usize
    let dotAfter: bool = false
    let i: usize = 0 as usize
    while i < len(address) {
        if address[i] <= 32 as u8 || address[i] == 127 as u8 { return false }
        if address[i] == 64 as u8 { at = at + 1 as usize }
        if address[i] == 46 as u8 && at == 1 as usize { dotAfter = true }
        i = i + 1 as usize
    }
    return at == 1 as usize && dotAfter
}
