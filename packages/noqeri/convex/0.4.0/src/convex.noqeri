module noqeri.convex

extern function providerHttpJson(method: string, url: string, authKind: string, authValue: string, headerName: string, headerValue: string, body: string): string
extern function providerHttpStatus(): int

export function convexApiSuffix(): string { return "/api" }
export function convexCredentialPresent(value: string): bool { return textLength(value) >= 8 }
export function convexLastStatus(): int { return providerHttpStatus() }
export function convexQueryUrl(deploymentUrl: string): string { return deploymentUrl + "/api/query" }
export function convexMutationUrl(deploymentUrl: string): string { return deploymentUrl + "/api/mutation" }
export function convexActionUrl(deploymentUrl: string): string { return deploymentUrl + "/api/action" }
export function convexQuery(deploymentUrl: string, userToken: string, body: string): string { return providerHttpJson("POST", convexQueryUrl(deploymentUrl), "bearer", userToken, "", "", body) }
export function convexMutation(deploymentUrl: string, userToken: string, body: string): string { return providerHttpJson("POST", convexMutationUrl(deploymentUrl), "bearer", userToken, "", "", body) }
