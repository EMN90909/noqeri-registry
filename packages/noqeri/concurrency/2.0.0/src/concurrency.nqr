module noqeri.concurrency

// Canonical Noqeri concurrency package. Version 2 uses the same host ABI as
// noqeri.std.task/channel/mutex/rwlock so the reference runtime can execute it
// directly. Named task entry points remain until first-class function values
// are available in the self-host compiler.

extern function taskHostSpawn(entry: string, payload: string): usize
extern function taskHostState(task: usize): int
extern function taskHostJoin(task: usize, timeoutMillis: i64): isize
extern function taskHostCancel(task: usize): bool
extern function taskHostDestroy(task: usize): bool
extern function taskHostCancelled(task: usize): bool
extern function taskHostCurrentCancelled(): bool

extern function channelHostCreate(capacity: usize): usize
extern function channelHostSendI64(channel: usize, value: i64, timeoutMillis: i64): isize
extern function channelHostReceiveI64(channel: usize, timeoutMillis: i64): i64
extern function channelHostCount(channel: usize): usize
extern function channelHostClose(channel: usize): bool
extern function channelHostDestroy(channel: usize): bool

extern function mutexHostCreate(): usize
extern function mutexHostLock(mutex: usize, timeoutMillis: i64): bool
extern function mutexHostTryLock(mutex: usize): bool
extern function mutexHostUnlock(mutex: usize): bool
extern function mutexHostDestroy(mutex: usize): bool

extern function rwlockHostCreate(): usize
extern function rwlockHostReadLock(lock: usize, timeoutMillis: i64): bool
extern function rwlockHostWriteLock(lock: usize, timeoutMillis: i64): bool
extern function rwlockHostTryRead(lock: usize): bool
extern function rwlockHostTryWrite(lock: usize): bool
extern function rwlockHostUnlock(lock: usize): bool
extern function rwlockHostDestroy(lock: usize): bool

export function task_pending(): int { return 0 }
export function task_running(): int { return 1 }
export function task_ready(): int { return 2 }
export function task_failed(): int { return 3 }
export function task_cancelled_state(): int { return 4 }

export function valid_handle(handle: usize): bool { return handle != 0 as usize }
export function valid_timeout(timeoutMillis: i64): bool { return timeoutMillis >= 0 as i64 }
export function is_timeout(status: isize): bool { return status == -2 as isize }
export function is_cancelled(status: isize): bool { return status == -3 as isize }
export function ok(status: isize): bool { return status >= 0 as isize }

export function spawn(entry: string, payload: string): usize {
    unsafe { return taskHostSpawn(entry, payload) }
}

export function state(task: usize): int {
    if !valid_handle(task) { return task_failed() }
    unsafe { return taskHostState(task) }
}

export function join(task: usize, timeoutMillis: i64): isize {
    if !valid_handle(task) || !valid_timeout(timeoutMillis) { return -1 }
    unsafe { return taskHostJoin(task, timeoutMillis) }
}

export function cancel(task: usize): bool {
    if !valid_handle(task) { return false }
    unsafe { return taskHostCancel(task) }
}

export function cancelled(task: usize): bool {
    if !valid_handle(task) { return true }
    unsafe { return taskHostCancelled(task) }
}

export function current_cancelled(): bool {
    unsafe { return taskHostCurrentCancelled() }
}

export function destroy(task: usize): bool {
    if !valid_handle(task) { return false }
    unsafe { return taskHostDestroy(task) }
}

export function cancel_on_timeout(task: usize, timeoutMillis: i64): isize {
    let first = join(task, timeoutMillis)
    if is_timeout(first) {
        if !cancel(task) { return -1 }
        return join(task, 60000 as i64)
    }
    return first
}

export function channel(capacity: usize): usize {
    if capacity == 0 as usize || capacity > 1048576 as usize { return 0 as usize }
    unsafe { return channelHostCreate(capacity) }
}

export function send_i64(ch: usize, value: i64, timeoutMillis: i64): isize {
    if !valid_handle(ch) || !valid_timeout(timeoutMillis) { return -1 }
    unsafe { return channelHostSendI64(ch, value, timeoutMillis) }
}

export function receive_i64(ch: usize, timeoutMillis: i64): i64 {
    if !valid_handle(ch) || !valid_timeout(timeoutMillis) { return 0 as i64 }
    unsafe { return channelHostReceiveI64(ch, timeoutMillis) }
}

export function channel_count(ch: usize): usize {
    if !valid_handle(ch) { return 0 as usize }
    unsafe { return channelHostCount(ch) }
}

export function channel_close(ch: usize): bool {
    if !valid_handle(ch) { return false }
    unsafe { return channelHostClose(ch) }
}

export function channel_destroy(ch: usize): bool {
    if !valid_handle(ch) { return false }
    unsafe { return channelHostDestroy(ch) }
}

export function mutex(): usize { unsafe { return mutexHostCreate() } }
export function mutex_lock(handle: usize, timeoutMillis: i64): bool {
    if !valid_handle(handle) || !valid_timeout(timeoutMillis) { return false }
    unsafe { return mutexHostLock(handle, timeoutMillis) }
}
export function mutex_try_lock(handle: usize): bool {
    if !valid_handle(handle) { return false }
    unsafe { return mutexHostTryLock(handle) }
}
export function mutex_unlock(handle: usize): bool {
    if !valid_handle(handle) { return false }
    unsafe { return mutexHostUnlock(handle) }
}
export function mutex_destroy(handle: usize): bool {
    if !valid_handle(handle) { return false }
    unsafe { return mutexHostDestroy(handle) }
}

export function rwlock(): usize { unsafe { return rwlockHostCreate() } }
export function rwlock_read(handle: usize, timeoutMillis: i64): bool {
    if !valid_handle(handle) || !valid_timeout(timeoutMillis) { return false }
    unsafe { return rwlockHostReadLock(handle, timeoutMillis) }
}
export function rwlock_write(handle: usize, timeoutMillis: i64): bool {
    if !valid_handle(handle) || !valid_timeout(timeoutMillis) { return false }
    unsafe { return rwlockHostWriteLock(handle, timeoutMillis) }
}
export function rwlock_try_read(handle: usize): bool {
    if !valid_handle(handle) { return false }
    unsafe { return rwlockHostTryRead(handle) }
}
export function rwlock_try_write(handle: usize): bool {
    if !valid_handle(handle) { return false }
    unsafe { return rwlockHostTryWrite(handle) }
}
export function rwlock_unlock(handle: usize): bool {
    if !valid_handle(handle) { return false }
    unsafe { return rwlockHostUnlock(handle) }
}
export function rwlock_destroy(handle: usize): bool {
    if !valid_handle(handle) { return false }
    unsafe { return rwlockHostDestroy(handle) }
}
