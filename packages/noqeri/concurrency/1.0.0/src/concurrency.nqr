module noqeri.concurrency

// Public concurrency package built on the standard runtime concurrency ABI.
// Handles are signed machine-size integers. Negative status values indicate
// failure; -2 is timeout and -3 is cancellation.

extern function taskSpawn(entry: string): isize
extern function taskJoin(task: isize): isize
extern function taskCancel(task: isize): isize
extern function taskIsCancelled(task: isize): bool
extern function taskSleepMillis(milliseconds: i64): isize
extern function taskJoinTimeout(task: isize, milliseconds: i64): isize

extern function channelCreate(capacity: usize): isize
extern function channelSend(channel: isize, value: isize): isize
extern function channelReceive(channel: isize): isize
extern function channelSendTimeout(channel: isize, value: isize, milliseconds: i64): isize
extern function channelReceiveTimeout(channel: isize, milliseconds: i64): isize
extern function channelClose(channel: isize): isize

extern function mutexCreate(): isize
extern function mutexLock(mutex: isize): isize
extern function mutexTryLock(mutex: isize): bool
extern function mutexUnlock(mutex: isize): isize

extern function rwlockCreate(): isize
extern function rwlockReadLock(lock: isize): isize
extern function rwlockReadUnlock(lock: isize): isize
extern function rwlockWriteLock(lock: isize): isize
extern function rwlockWriteUnlock(lock: isize): isize

export function spawn(entry: string): isize { return taskSpawn(entry) }
export function join(task: isize): isize { return taskJoin(task) }
export function cancel(task: isize): isize { return taskCancel(task) }
export function cancelled(task: isize): bool { return taskIsCancelled(task) }
export function sleep(milliseconds: i64): isize { return taskSleepMillis(milliseconds) }
export function join_timeout(task: isize, milliseconds: i64): isize { return taskJoinTimeout(task, milliseconds) }

export function channel(capacity: usize): isize { return channelCreate(capacity) }
export function send(ch: isize, value: isize): isize { return channelSend(ch, value) }
export function receive(ch: isize): isize { return channelReceive(ch) }
export function send_timeout(ch: isize, value: isize, milliseconds: i64): isize { return channelSendTimeout(ch, value, milliseconds) }
export function receive_timeout(ch: isize, milliseconds: i64): isize { return channelReceiveTimeout(ch, milliseconds) }
export function close(ch: isize): isize { return channelClose(ch) }

export function mutex(): isize { return mutexCreate() }
export function lock(mutex_handle: isize): isize { return mutexLock(mutex_handle) }
export function try_lock(mutex_handle: isize): bool { return mutexTryLock(mutex_handle) }
export function unlock(mutex_handle: isize): isize { return mutexUnlock(mutex_handle) }

export function rwlock(): isize { return rwlockCreate() }
export function read_lock(lock_handle: isize): isize { return rwlockReadLock(lock_handle) }
export function read_unlock(lock_handle: isize): isize { return rwlockReadUnlock(lock_handle) }
export function write_lock(lock_handle: isize): isize { return rwlockWriteLock(lock_handle) }
export function write_unlock(lock_handle: isize): isize { return rwlockWriteUnlock(lock_handle) }

export function ok(status: isize): bool { return status >= 0 as isize }
export function is_timeout(status: isize): bool { return status == -2 as isize }
export function is_cancelled(status: isize): bool { return status == -3 as isize }

// Structured-concurrency helper: callers can join a child with a timeout and
// request cancellation if the timeout fires. The subsequent join gives the
// runtime a chance to reclaim task resources deterministically.
export function cancel_on_timeout(task: isize, timeout_millis: i64): isize {
    let first = join_timeout(task, timeout_millis)
    if is_timeout(first) {
        let cancelled_status = cancel(task)
        if cancelled_status < 0 as isize {
            return cancelled_status
        }
        return join(task)
    }
    return first
}
