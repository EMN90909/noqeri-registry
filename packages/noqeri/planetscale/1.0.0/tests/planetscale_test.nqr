import "../src/planetscale.nqr"
function require(ok: bool): void { if !ok { let invalid: *u8 = 0 as *u8 print(invalid[0]) } }
require(planetscaleServiceAuthorization("id", "secret") == "id:secret")
require(planetscaleOrganizationsUrl() == "https://api.planetscale.com/v1/organizations")
print("planetscale package tests: OK")
