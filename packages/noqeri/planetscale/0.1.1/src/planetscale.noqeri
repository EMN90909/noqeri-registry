// Explicit host boundary: this module is an API adapter, not a bundled HTTP stack.
module noqeri.planetscale
extern function providerHttpJson(method: string, url: string, authKind: string, authValue: string, headerName: string, headerValue: string, body: string): string
extern function providerHttpStatus(): int
export function planetscaleRoot(): string { return "https://api.planetscale.com/v1" }
export function planetscaleStatus(): int { return providerHttpStatus() }
export function planetscaleSuccess(code: int): bool { return code >= 200 && code < 300 }
export function planetscaleRateLimited(code: int): bool { return code == 429 }
export function planetscaleRetryable(code: int): bool { return code == 408 || code == 423 || code == 429 || code == 500 || code == 502 || code == 503 || code == 504 }
export function planetscaleMethodAllowed(method: string): bool { return method == "GET" || method == "POST" || method == "PATCH" || method == "PUT" || method == "DELETE" }
export function planetscaleCredentialValid(token: string): bool { return textLength(token) >= 8 && textLength(token) <= 8192 }
export function planetscaleBodyValid(size: usize): bool { return size <= 1048576 as usize }
export function planetscalePageSizeValid(size: int): bool { return size > 0 && size <= 100 }
export function planetscaleIdentifierChar(c: u8): bool {
    return (c >= 65 as u8 && c <= 90 as u8) || (c >= 97 as u8 && c <= 122 as u8) || (c >= 48 as u8 && c <= 57 as u8) || c == 45 as u8 || c == 95 as u8 || c == 46 as u8
}
export function planetscaleIdentifierValid(id: []u8): bool {
    if len(id) == 0 as usize || len(id) > 128 as usize { return false }
    if len(id) == 1 as usize && id[0] == 46 as u8 { return false }
    if len(id) == 2 as usize && id[0] == 46 as u8 && id[1] == 46 as u8 { return false }
    let i: usize = 0 as usize
    while i < len(id) { if !planetscaleIdentifierChar(id[i]) { return false } i = i + 1 as usize }
    return true
}
export function planetscaleDelayMillis(attempt: int): int {
    if attempt <= 0 { return 200 }
    if attempt == 1 { return 400 }
    if attempt == 2 { return 800 }
    if attempt == 3 { return 1600 }
    return 3200
}
export function planetscaleRequest(method: string, token: string, url: string, body: string): string {
    if !planetscaleMethodAllowed(method) || !planetscaleCredentialValid(token) || textLength(url) < 10 || textLength(body) > 1048576 { return "" }
    return providerHttpJson(method,url,"bearer",token,"Accept","application/json",body)
}
export function planetscaleOrganizationsUrl(): string { return planetscaleRoot() + "/organizations" }
export function planetscaleOrganizationUrl(org: string): string { return planetscaleRoot() + "/organizations/" + org }
export function planetscaleDatabasesUrl(org: string): string { return planetscaleRoot() + "/organizations/" + org + "/databases" }
export function planetscaleDatabaseUrl(org: string, database: string): string { return planetscaleRoot() + "/organizations/" + org + "/databases/" + database }
export function planetscaleBranchesUrl(org: string, database: string): string { return planetscaleRoot() + "/organizations/" + org + "/databases/" + database + "/branches" }
export function planetscaleBranchUrl(org: string, database: string, branch: string): string { return planetscaleRoot() + "/organizations/" + org + "/databases/" + database + "/branches/" + branch }
export function planetscaleDeployRequestsUrl(org: string, database: string): string { return planetscaleRoot() + "/organizations/" + org + "/databases/" + database + "/deploy-requests" }
export function planetscalePasswordsUrl(org: string, database: string, branch: string): string { return planetscaleRoot() + "/organizations/" + org + "/databases/" + database + "/branches/" + branch + "/passwords" }
export function planetscaleRegionsUrl(): string { return planetscaleRoot() + "/regions" }
export function planetscaleServiceTokensUrl(org: string): string { return planetscaleRoot() + "/organizations/" + org + "/service-tokens" }
export function planetscaleGet(token: string, url: string): string { return planetscaleRequest("GET",token,url,"") }
export function planetscalePost(token: string, url: string, body: string): string { return planetscaleRequest("POST",token,url,body) }
export function planetscalePatch(token: string, url: string, body: string): string { return planetscaleRequest("PATCH",token,url,body) }
export function planetscaleDelete(token: string, url: string): string { return planetscaleRequest("DELETE",token,url,"") }
