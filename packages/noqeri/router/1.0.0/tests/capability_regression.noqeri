// Executable positive and negative capability contract.
import "../src/router.noqeri"
function main(): int {
    let pattern: [u8; 6] = [47 as u8,117 as u8,47 as u8,58 as u8,105 as u8,100 as u8]
    let good: [u8; 4] = [47 as u8,117 as u8,47 as u8,49 as u8]
    let bad: [u8; 3] = [47 as u8,117 as u8,47 as u8]
    if !routePatternMatch(slice(pattern),slice(good)) { return 1 }
    if routePatternMatch(slice(pattern),slice(bad)) { return 2 }

    return 0
}
