module noqeri.web

extern function webNavigate(url: string): bool
extern function webNowMillis(): u64

export function webStatusOk(status: int): bool { return status >= 200 && status <= 299 }
export function webStatusRetryable(status: int): bool { return status == 408 || status == 425 || status == 429 || status >= 500 }
export function webClampPercent(value: int): int { if value < 0 { return 0 } if value > 100 { return 100 } return value }

// Native Noqeri v0.5.0 additions.
export function webHttpsUrlValid(raw: []u8): bool {
 if len(raw) < 9 as usize || len(raw) > 4096 as usize { return false }
 let prefix: [u8; 8] = [104 as u8,116 as u8,116 as u8,112 as u8,115 as u8,58 as u8,47 as u8,47 as u8]
 let i: usize = 0 as usize
 while i < 8 as usize {
  if raw[i] != prefix[i] { return false }
  i = i + 1 as usize
 }
 let host: usize = 0 as usize
 while i < len(raw) {
  let c: u8 = raw[i]
  if c == 47 as u8 || c == 63 as u8 { break }
  if c < 33 as u8 || c == 92 as u8 || c == 64 as u8 || c == 35 as u8 { return false }
  host = host + 1 as usize
  i = i + 1 as usize
 }
 if host == 0 as usize { return false }
 while i < len(raw) {
  if raw[i] < 32 as u8 || raw[i] == 92 as u8 || raw[i] == 35 as u8 { return false }
  i = i + 1 as usize
 }
 return true
}
export function webHeaderToken(c: u8): bool {
 if c >= 65 as u8 && c <= 90 as u8 { return true }
 if c >= 97 as u8 && c <= 122 as u8 { return true }
 if c >= 48 as u8 && c <= 57 as u8 { return true }
 return c == 45 as u8 || c == 95 as u8
}
export function webHeaderNameValid(header: []u8): bool {
 if len(header) == 0 as usize || len(header) > 256 as usize { return false }
 let i: usize = 0 as usize
 while i < len(header) { if !webHeaderToken(header[i]) { return false } i = i + 1 as usize }
 return true
}
export function webRequestBodyValid(bytes: usize): bool { return bytes <= 8388608 as usize }
