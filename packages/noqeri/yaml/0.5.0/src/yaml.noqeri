module noqeri.yaml
export function yamlIndentValid(spaces: usize): bool { return spaces <= 256 as usize }
export function yamlDepthValid(depth: usize): bool { return depth <= 64 as usize }
export function yamlAliasCountValid(count: usize): bool { return count <= 128 as usize }
export function yamlDocumentBytesValid(bytes: usize): bool { return bytes <= 16 as usize * 1024 as usize * 1024 as usize }
export function yamlPlainScalarStart(value: u8): bool { return value != 35 as u8 && value != 45 as u8 && value != 63 as u8 && value != 58 as u8 && value != 44 as u8 && value != 91 as u8 && value != 93 as u8 && value != 123 as u8 && value != 125 as u8 }

// REGISTRY_CAPABILITY_UPGRADE_V2
export function yamlPlainKeyValid(value: []u8): bool {
    if len(value) == 0 as usize || !yamlPlainScalarStart(value[0]) { return false }
    let i: usize = 0 as usize
    while i < len(value) {
        if value[i] == 0 as u8 || value[i] == 10 as u8 || value[i] == 13 as u8 || value[i] == 58 as u8 { return false }
        i = i + 1 as usize
    }
    return true
}
export function yamlCountIndent(value: []u8): isize {
    let i: usize = 0 as usize
    while i < len(value) {
        if value[i] == 9 as u8 { return -1 as isize }
        if value[i] != 32 as u8 { return i as isize }
        i = i + 1 as usize
    }
    if !yamlIndentValid(i) { return -1 as isize }
    return i as isize
}

// Native Noqeri v0.5.0 additions.
export function yamlMappingColon(line: []u8): isize {
 if !yamlDocumentBytesValid(len(line)) { return -1 as isize }
 let quote: u8 = 0 as u8
 let escaped: bool = false
 let i: usize = 0 as usize
 while i < len(line) {
  let c: u8 = line[i]
  if quote != 0 as u8 {
   if escaped { escaped = false }
   else if c == 92 as u8 && quote == 34 as u8 { escaped = true }
   else if c == quote { quote = 0 as u8 }
  } else {
   if c == 34 as u8 || c == 39 as u8 { quote = c }
   else if c == 35 as u8 { return -1 as isize }
   else if c == 58 as u8 {
    if i + 1 as usize == len(line) || line[i + 1 as usize] == 32 as u8 || line[i + 1 as usize] == 9 as u8 { return i as isize }
   }
  }
  i = i + 1 as usize
 }
 return -1 as isize
}
export function yamlLineKind(line: []u8): int {
 let offset: isize = yamlCountIndent(line)
 if offset < 0 as isize { return -1 }
 let i: usize = offset as usize
 if i >= len(line) || line[i] == 35 as u8 { return 0 }
 if line[i] == 45 as u8 && (i + 1 as usize == len(line) || line[i + 1 as usize] == 32 as u8) { return 2 }
 if yamlMappingColon(line) >= 0 as isize { return 1 }
 return 3
}
