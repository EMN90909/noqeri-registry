// Working capability example with visible positive and negative cases.
import "../src/tls.noqeri"
function main(): int {
    let good: [u8; 5] = [22 as u8,3 as u8,3 as u8,0 as u8,32 as u8]
    let bad: [u8; 5] = [0 as u8,3 as u8,3 as u8,0 as u8,32 as u8]
    if !tlsRecordHeaderValid(slice(good)) || tlsRecordHeaderValid(slice(bad)) { return 1 }

    return 0
}
