module noqeri.http_server

extern function httpServerListen(port: int): usize
extern function httpServerClose(server: usize): bool

export function httpPortValid(port: int): bool { return port > 0 && port <= 65535 }
export function httpBodyAllowed(status: int): bool { return status != 204 && status != 304 && (status < 100 || status >= 200) }
export function httpDefaultPort(tls: bool): int { if tls { return 443 } return 80 }
export function httpServerStart(port: int): usize { if !httpPortValid(port) { return 0 as usize } return httpServerListen(port) }
