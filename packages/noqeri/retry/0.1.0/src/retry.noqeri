module noqeri.retry

export function retryStatusTransient(status: int): bool {
    return status == 408 || status == 425 || status == 429 || status == 500 || status == 502 || status == 503 || status == 504
}

export function retryDelayMillis(attempt: usize, baseMillis: i64, maxMillis: i64): i64 {
    if baseMillis <= 0 as i64 || maxMillis <= 0 as i64 { return 0 as i64 }
    let delay: i64 = baseMillis
    let index: usize = 0 as usize
    while index < attempt && delay < maxMillis {
        if delay > maxMillis / 2 as i64 { return maxMillis }
        delay = delay * 2 as i64
        index = index + 1 as usize
    }
    if delay > maxMillis { return maxMillis }
    return delay
}

export function retryAllowed(attempt: usize, maxAttempts: usize, status: int): bool {
    return attempt < maxAttempts && retryStatusTransient(status)
}
