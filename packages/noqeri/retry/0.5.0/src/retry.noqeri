module noqeri.retry

export function retryStatusTransient(status: int): bool {
    return status == 408 || status == 425 || status == 429 || status == 500 || status == 502 || status == 503 || status == 504
}

export function retryDelayMillis(attempt: usize, baseMillis: i64, maxMillis: i64): i64 {
    if baseMillis <= 0 as i64 || maxMillis <= 0 as i64 { return 0 as i64 }
    let delay: i64 = baseMillis
    let index: usize = 0 as usize
    while index < attempt && delay < maxMillis {
        if delay > maxMillis / 2 as i64 { return maxMillis }
        delay = delay * 2 as i64
        index = index + 1 as usize
    }
    if delay > maxMillis { return maxMillis }
    return delay
}

export function retryAllowed(attempt: usize, maxAttempts: usize, status: int): bool {
    return attempt < maxAttempts && retryStatusTransient(status)
}

// v0.5.0: substantive runtime functionality; no Node.js dependency.
export function retryStatusThrottled(status: int): bool { return status == 429 || status == 503 }
export function retryShouldBackoff(attempt: usize, maximum: usize, status: int, idempotent: bool): bool {
 if !idempotent || maximum == 0 as usize { return false }
 return retryAllowed(attempt,maximum,status)
}
// Random unit is an external uniform sample in [0,1000], not generated here.
export function retryFullJitterMillis(attempt: usize, baseMillis: i64, capMillis: i64, sample: usize): i64 {
 let delay: i64 = retryDelayMillis(attempt,baseMillis,capMillis)
 if delay <= 0 as i64 || sample > 1000 as usize { return -1 as i64 }
 // Division before multiplication prevents overflow.
 return (delay / 1000 as i64) * sample as i64 + ((delay % 1000 as i64) * sample as i64) / 1000 as i64
}
export function retryAfterSecondsMillis(seconds: i64, capMillis: i64): i64 {
 if seconds < 0 as i64 || capMillis <= 0 as i64 { return -1 as i64 }
 if seconds >= capMillis / 1000 as i64 { return capMillis }
 return seconds * 1000 as i64
}
export function retryDelayWithHint(attempt: usize, baseMillis: i64, capMillis: i64, retryAfterMillis: i64): i64 {
 let delay: i64 = retryDelayMillis(attempt,baseMillis,capMillis)
 if retryAfterMillis < 0 as i64 { return delay }
 if retryAfterMillis >= capMillis { return capMillis }
 if retryAfterMillis > delay { return retryAfterMillis }
 return delay
}
