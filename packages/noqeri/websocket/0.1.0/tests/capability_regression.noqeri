// Executable positive and negative capability contract.
import "../src/websocket.noqeri"
function main(): int {
    if !websocketControlFrameValid(9 as u8,true,true,10 as usize) { return 1 }
    if websocketControlFrameValid(9 as u8,false,true,10 as usize) { return 2 }
    if websocketClientFrameValid(1 as u8,false,2 as usize) { return 3 }

    return 0
}
