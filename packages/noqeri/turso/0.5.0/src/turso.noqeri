module noqeri.turso

extern function providerHttpJson(method: string, url: string, authKind: string, authValue: string, headerName: string, headerValue: string, body: string): string
extern function providerHttpStatus(): int

export function tursoPlatformApiRoot(): string { return "https://api.turso.tech/v1" }
export function tursoCredentialPresent(value: string): bool { return textLength(value) >= 8 }
export function tursoLastStatus(): int { return providerHttpStatus() }
export function tursoPipelineUrl(databaseHttpUrl: string): string { return databaseHttpUrl + "/v2/pipeline" }
export function tursoQuery(databaseHttpUrl: string, token: string, body: string): string { if !tursoCredentialPresent(token) { return "" } return providerHttpJson("POST", tursoPipelineUrl(databaseHttpUrl), "bearer", token, "", "", body) }
export function tursoVersion(databaseHttpUrl: string, token: string): string { return providerHttpJson("GET", databaseHttpUrl + "/version", "bearer", token, "", "", "") }

// Expanded Noqeri-native 0.5.0 policy and request functionality.
export function tursoHttpSuccess(status: int): bool { return status >= 200 && status < 300 }
export function tursoRetryable(status: int): bool { return status == 408 || status == 425 || status == 429 || status == 500 || status == 502 || status == 503 || status == 504 }
export function tursoRequestBodyValid(bytes: usize): bool { return bytes <= 1048576 as usize }
export function tursoDatabaseUrlValid(url: []u8): bool {
 if len(url) < 19 as usize || len(url) > 4096 as usize { return false }
 let scheme: [u8; 8] = [104 as u8,116 as u8,116 as u8,112 as u8,115 as u8,58 as u8,47 as u8,47 as u8]
 let i: usize = 0 as usize
 while i < 8 as usize { if url[i] != scheme[i] { return false } i = i + 1 as usize }
 let hostStart: usize = i
 while i < len(url) && url[i] != 47 as u8 && url[i] != 63 as u8 {
  if url[i] < 33 as u8 || url[i] == 64 as u8 || url[i] == 92 as u8 || url[i] == 35 as u8 { return false }
  i = i + 1 as usize
 }
 let suffix: [u8; 9] = [46 as u8,116 as u8,117 as u8,114 as u8,115 as u8,111 as u8,46 as u8,105 as u8,111 as u8]
 if i <= hostStart + 9 as usize { return false }
 let j: usize = 0 as usize
 while j < 9 as usize { if url[i - 9 as usize + j] != suffix[j] { return false } j = j + 1 as usize }
 return true
}
export function tursoExecuteBatch(databaseHttpUrl: string, token: string, requestBody: string): string {
 if !tursoCredentialPresent(token) || !tursoRequestBodyValid(textLength(requestBody)) { return "" }
 return providerHttpJson("POST",tursoPipelineUrl(databaseHttpUrl),"bearer",token,"Content-Type","application/json",requestBody)
}
export function tursoGetVersion(databaseHttpUrl: string, token: string): string {
 if !tursoCredentialPresent(token) { return "" }
 return providerHttpJson("GET",databaseHttpUrl + "/version","bearer",token,"Accept","application/json","")
}
