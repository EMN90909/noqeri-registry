module noqeri.core

export function nqMin(left: int, right: int): int { if left < right { return left } return right }
export function nqMax(left: int, right: int): int { if left > right { return left } return right }
export function nqClamp(value: int, low: int, high: int): int { if value < low { return low } if value > high { return high } return value }
export function nqAbs(value: int): int { if value < 0 { return 0 - value } return value }
export function nqBoolToInt(value: bool): int { if value { return 1 } return 0 }

// REGISTRY_CAPABILITY_UPGRADE_V2
export function coreBytesEqual(left: []u8, right: []u8): bool {
    if len(left) != len(right) { return false }
    let i: usize = 0 as usize
    while i < len(left) { if left[i] != right[i] { return false } i = i + 1 as usize }
    return true
}
export function coreBytesIndexOf(data: []u8, needle: u8): isize {
    let i: usize = 0 as usize
    while i < len(data) { if data[i] == needle { return i as isize } i = i + 1 as usize }
    return -1 as isize
}
export function coreBytesCopy(source: []u8, destination: []u8): isize {
    if len(source) > len(destination) { return -1 as isize }
    let i: usize = 0 as usize
    while i < len(source) { destination[i] = source[i] i = i + 1 as usize }
    return len(source) as isize
}
export function coreRangeValid(offset: usize, count: usize, length: usize): bool {
    return offset <= length && count <= length - offset
}
