// Working capability example with visible positive and negative cases.
import "../src/core.noqeri"
function main(): int {
    let a: [u8; 3] = [1 as u8,2 as u8,3 as u8]
    let b: [u8; 3] = [0 as u8,0 as u8,0 as u8]
    if coreBytesCopy(slice(a),slice(b)) != 3 as isize { return 1 }
    if !coreBytesEqual(slice(a),slice(b)) { return 2 }
    if coreBytesIndexOf(slice(b),2 as u8) != 1 as isize { return 3 }
    if coreRangeValid(3 as usize,1 as usize,3 as usize) { return 4 }

    return 0
}
