// All tests are network-independent; external transports require host integration.
import "../src/core.noqeri"
function main(): int {
    let bytes: [u8; 4] = [49 as u8,50 as u8,51 as u8,52 as u8]
    let copy: [u8; 4] = [0 as u8,0 as u8,0 as u8,0 as u8]
    print(1)
    if coreBytesCopy(slice(bytes),slice(copy)) != 4 as isize { return 1 }
    print(2)
    if !coreBytesEqual(slice(bytes),slice(copy)) || coreBytesCompare(slice(bytes),slice(copy)) != 0 { return 2 }
    print(3)
    if coreBytesIndexOf(slice(bytes),51 as u8) != 2 as isize { return 3 }
    print(4)
    if coreBytesLastIndexOf(slice(bytes),52 as u8) != 3 as isize { return 4 }
    let needle: [u8; 2] = [50 as u8,51 as u8]
    print(5)
    if coreBytesFind(slice(bytes),slice(needle)) != 1 as isize { return 5 }
    print(6)
    if !coreBytesStartsWith(slice(bytes),slice(needle)) && coreBytesIndexOf(slice(bytes),50 as u8) != 1 as isize { return 6 }
    let result: u64 = 0 as u64
    print(7)
    if !coreDecimalParseU64(slice(bytes),&result) || result != 1234 as u64 { return 7 }
    let out: [u8; 5] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    print(8)
    if coreDecimalFormatU64(result,slice(out)) != 4 as isize { return 8 }
    print(9)
    if out[0] != 49 as u8 || out[3] != 52 as u8 { return 9 }
    print(10)
    if coreRangeValid(4 as usize,1 as usize,4 as usize) { return 10 }
    print(11)
    if coreBytesFill(slice(copy),0 as u8) != 4 as usize || copy[0] != 0 as u8 { return 11 }
    return 0
}
print(main())
