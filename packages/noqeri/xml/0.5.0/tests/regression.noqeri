import "../src/xml.noqeri"
function main(): int {
let input: [u8; 3] = [60 as u8,38 as u8,62 as u8]
let result: [u8; 13] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
if xmlTextEscapedLength(slice(input),false) != 13 as usize { return 1 }
if xmlTextEscape(slice(input),slice(result),false) != 13 as isize { return 2 }
if result[0] != 38 as u8 || result[4] != 38 as u8 || result[9] != 38 as u8 { return 3 }
 return 0
}
print(main())
