// Canonical Noqeri registry application and HTTP protocol routing.
// Native C++ is limited to operating-system I/O, wire serialization and archive plumbing.
// The source-catalog native mode is an explicitly gated PREVIEW, not a replacement
// for a qualified native NoeSQL session or durable publication service.
module noqeri.registry

extern function registryHostServe(databasePath: string, artifactsPath: string, port: int): isize

export function registryNameByteValid(value: u8): bool {
    return (value >= 97 as u8 && value <= 122 as u8) || (value >= 48 as u8 && value <= 57 as u8) || value == 45 as u8
}
export function registryNameValid(value: []u8): bool {
    if len(value) == 0 as usize { return false }
    let i: usize = 0 as usize
    while i < len(value) {
        if !registryNameByteValid(value[i]) { return false }
        i = i + 1
    }
    return true
}

// Pure Noqeri protocol guards for the future native transport.
// They have no runtime dependency on Node and can be executed by a native compiler.
export function registryHexByteValid(value: u8): bool {
    return (value >= 48 as u8 && value <= 57 as u8) || (value >= 97 as u8 && value <= 102 as u8)
}
export function registryArchiveSha256Valid(hex: []u8): bool {
    if len(hex) != 64 as usize { return false }
    let i: usize = 0 as usize
    while i < len(hex) {
        if !registryHexByteValid(hex[i]) { return false }
        i = i + 1 as usize
    }
    return true
}
export function registryPaginationValid(offset: usize, limit: usize): bool {
    return offset <= 99999999 as usize && limit >= 1 as usize && limit <= 100 as usize
}
export function registrySearchBytesValid(length: usize): bool { return length <= 128 as usize }
export function registryRequestPathBytesValid(length: usize): bool { return length <= 512 as usize }
export function registryQueryStringBytesValid(length: usize): bool { return length <= 2048 as usize }

// All route selection and byte-level URI policy are authored in Noqeri.
// The native boundary passes a borrowed buffer: it must stay alive for this call.
// Route IDs: 1=health, 2=status, 3=index, 4=package-list,
//            5=search, 6=advisories, 7=package subresource,
//            8=download page, 9=verified published releases, 0=unknown.
// Dereference only inside this explicit unsafe boundary; callers check length.
export function registryByteAt(value: *u8, offset: usize): u8 {
    unsafe { return value[offset] }
}

export function registryIsHealth(path: *u8, length: usize): bool {
    if path == null || length != 7 as usize { return false }
    return registryByteAt(path, 0 as usize) == 47 as u8 &&
        registryByteAt(path, 1 as usize) == 104 as u8 &&
        registryByteAt(path, 2 as usize) == 101 as u8 &&
        registryByteAt(path, 3 as usize) == 97 as u8 &&
        registryByteAt(path, 4 as usize) == 108 as u8 &&
        registryByteAt(path, 5 as usize) == 116 as u8 &&
        registryByteAt(path, 6 as usize) == 104 as u8
}

export function registryIsStatus(path: *u8, length: usize): bool {
    if path == null || length != 10 as usize { return false }
    return registryByteAt(path, 0 as usize) == 47 as u8 &&
        registryByteAt(path, 1 as usize) == 118 as u8 &&
        registryByteAt(path, 2 as usize) == 49 as u8 &&
        registryByteAt(path, 3 as usize) == 47 as u8 &&
        registryByteAt(path, 4 as usize) == 115 as u8 &&
        registryByteAt(path, 5 as usize) == 116 as u8 &&
        registryByteAt(path, 6 as usize) == 97 as u8 &&
        registryByteAt(path, 7 as usize) == 116 as u8 &&
        registryByteAt(path, 8 as usize) == 117 as u8 &&
        registryByteAt(path, 9 as usize) == 115 as u8
}

export function registryIsIndex(path: *u8, length: usize): bool {
    if path == null || length != 9 as usize { return false }
    return registryByteAt(path, 0 as usize) == 47 as u8 &&
        registryByteAt(path, 1 as usize) == 118 as u8 &&
        registryByteAt(path, 2 as usize) == 49 as u8 &&
        registryByteAt(path, 3 as usize) == 47 as u8 &&
        registryByteAt(path, 4 as usize) == 105 as u8 &&
        registryByteAt(path, 5 as usize) == 110 as u8 &&
        registryByteAt(path, 6 as usize) == 100 as u8 &&
        registryByteAt(path, 7 as usize) == 101 as u8 &&
        registryByteAt(path, 8 as usize) == 120 as u8
}

export function registryIsPackages(path: *u8, length: usize): bool {
    if path == null || length != 12 as usize { return false }
    return registryByteAt(path, 0 as usize) == 47 as u8 &&
        registryByteAt(path, 1 as usize) == 118 as u8 &&
        registryByteAt(path, 2 as usize) == 49 as u8 &&
        registryByteAt(path, 3 as usize) == 47 as u8 &&
        registryByteAt(path, 4 as usize) == 112 as u8 &&
        registryByteAt(path, 5 as usize) == 97 as u8 &&
        registryByteAt(path, 6 as usize) == 99 as u8 &&
        registryByteAt(path, 7 as usize) == 107 as u8 &&
        registryByteAt(path, 8 as usize) == 97 as u8 &&
        registryByteAt(path, 9 as usize) == 103 as u8 &&
        registryByteAt(path, 10 as usize) == 101 as u8 &&
        registryByteAt(path, 11 as usize) == 115 as u8
}

export function registryIsSearch(path: *u8, length: usize): bool {
    if path == null || length != 10 as usize { return false }
    return registryByteAt(path, 0 as usize) == 47 as u8 &&
        registryByteAt(path, 1 as usize) == 118 as u8 &&
        registryByteAt(path, 2 as usize) == 49 as u8 &&
        registryByteAt(path, 3 as usize) == 47 as u8 &&
        registryByteAt(path, 4 as usize) == 115 as u8 &&
        registryByteAt(path, 5 as usize) == 101 as u8 &&
        registryByteAt(path, 6 as usize) == 97 as u8 &&
        registryByteAt(path, 7 as usize) == 114 as u8 &&
        registryByteAt(path, 8 as usize) == 99 as u8 &&
        registryByteAt(path, 9 as usize) == 104 as u8
}

export function registryIsAdvisories(path: *u8, length: usize): bool {
    if path == null || length != 14 as usize { return false }
    return registryByteAt(path, 0 as usize) == 47 as u8 &&
        registryByteAt(path, 1 as usize) == 118 as u8 &&
        registryByteAt(path, 2 as usize) == 49 as u8 &&
        registryByteAt(path, 3 as usize) == 47 as u8 &&
        registryByteAt(path, 4 as usize) == 97 as u8 &&
        registryByteAt(path, 5 as usize) == 100 as u8 &&
        registryByteAt(path, 6 as usize) == 118 as u8 &&
        registryByteAt(path, 7 as usize) == 105 as u8 &&
        registryByteAt(path, 8 as usize) == 115 as u8 &&
        registryByteAt(path, 9 as usize) == 111 as u8 &&
        registryByteAt(path, 10 as usize) == 114 as u8 &&
        registryByteAt(path, 11 as usize) == 105 as u8 &&
        registryByteAt(path, 12 as usize) == 101 as u8 &&
        registryByteAt(path, 13 as usize) == 115 as u8
}

export function registryIsPackageSubresource(path: *u8, length: usize): bool {
    if path == null || length < 13 as usize { return false }
    return registryByteAt(path, 0 as usize) == 47 as u8 &&
        registryByteAt(path, 1 as usize) == 118 as u8 &&
        registryByteAt(path, 2 as usize) == 49 as u8 &&
        registryByteAt(path, 3 as usize) == 47 as u8 &&
        registryByteAt(path, 4 as usize) == 112 as u8 &&
        registryByteAt(path, 5 as usize) == 97 as u8 &&
        registryByteAt(path, 6 as usize) == 99 as u8 &&
        registryByteAt(path, 7 as usize) == 107 as u8 &&
        registryByteAt(path, 8 as usize) == 97 as u8 &&
        registryByteAt(path, 9 as usize) == 103 as u8 &&
        registryByteAt(path, 10 as usize) == 101 as u8 &&
        registryByteAt(path, 11 as usize) == 115 as u8 &&
        registryByteAt(path, 12 as usize) == 47 as u8
}
export function registryIsGet(path: *u8, length: usize): bool {
    if path == null || length != 3 as usize { return false }
    return registryByteAt(path, 0 as usize) == 71 as u8 &&
        registryByteAt(path, 1 as usize) == 69 as u8 &&
        registryByteAt(path, 2 as usize) == 84 as u8
}

export function registryIsHead(path: *u8, length: usize): bool {
    if path == null || length != 4 as usize { return false }
    return registryByteAt(path, 0 as usize) == 72 as u8 &&
        registryByteAt(path, 1 as usize) == 69 as u8 &&
        registryByteAt(path, 2 as usize) == 65 as u8 &&
        registryByteAt(path, 3 as usize) == 68 as u8
}
export function registryIdentityBytesValid(value: *u8, length: usize): bool {
    if value == null || length == 0 as usize || length > 128 as usize { return false }
    let i: usize = 0 as usize
    while i < length {
        if !registryNameByteValid(registryByteAt(value, i)) { return false }
        i = i + 1 as usize
    }
    return true
}
export function registryMethodValid(method: *u8, length: usize): bool {
    return registryIsGet(method, length) || registryIsHead(method, length)
}
export function registryPathSafe(path: *u8, length: usize): bool {
    if path == null || length == 0 as usize || !registryRequestPathBytesValid(length) { return false }
    if registryByteAt(path, 0 as usize) != 47 as u8 { return false }
    let i: usize = 0 as usize
    while i < length {
        let c: u8 = registryByteAt(path, i)
        // Reject controls, non-ASCII, percent escapes and backslashes rather
        // than ever decoding ambiguous filesystem paths in a privileged host.
        if c < 33 as u8 || c > 126 as u8 || c == 37 as u8 || c == 92 as u8 { return false }
        if i > 0 as usize && c == 47 as u8 && registryByteAt(path, i - 1 as usize) == 47 as u8 { return false }
        i = i + 1 as usize
    }
    return true
}
export function registryIsDownloadPage(path: *u8, length: usize): bool {
    if path == null || length != 10 as usize { return false }
    return registryByteAt(path, 0 as usize) == 47 as u8 &&
        registryByteAt(path, 1 as usize) == 100 as u8 &&
        registryByteAt(path, 2 as usize) == 111 as u8 &&
        registryByteAt(path, 3 as usize) == 119 as u8 &&
        registryByteAt(path, 4 as usize) == 110 as u8 &&
        registryByteAt(path, 5 as usize) == 108 as u8 &&
        registryByteAt(path, 6 as usize) == 111 as u8 &&
        registryByteAt(path, 7 as usize) == 97 as u8 &&
        registryByteAt(path, 8 as usize) == 100 as u8 &&
        registryByteAt(path, 9 as usize) == 115 as u8
}

export function registryIsDownloadPageSlash(path: *u8, length: usize): bool {
    if path == null || length != 11 as usize { return false }
    return registryByteAt(path, 0 as usize) == 47 as u8 &&
        registryByteAt(path, 1 as usize) == 100 as u8 &&
        registryByteAt(path, 2 as usize) == 111 as u8 &&
        registryByteAt(path, 3 as usize) == 119 as u8 &&
        registryByteAt(path, 4 as usize) == 110 as u8 &&
        registryByteAt(path, 5 as usize) == 108 as u8 &&
        registryByteAt(path, 6 as usize) == 111 as u8 &&
        registryByteAt(path, 7 as usize) == 97 as u8 &&
        registryByteAt(path, 8 as usize) == 100 as u8 &&
        registryByteAt(path, 9 as usize) == 115 as u8 &&
        registryByteAt(path, 10 as usize) == 47 as u8
}

export function registryIsReleases(path: *u8, length: usize): bool {
    if path == null || length != 12 as usize { return false }
    return registryByteAt(path, 0 as usize) == 47 as u8 &&
        registryByteAt(path, 1 as usize) == 118 as u8 &&
        registryByteAt(path, 2 as usize) == 49 as u8 &&
        registryByteAt(path, 3 as usize) == 47 as u8 &&
        registryByteAt(path, 4 as usize) == 114 as u8 &&
        registryByteAt(path, 5 as usize) == 101 as u8 &&
        registryByteAt(path, 6 as usize) == 108 as u8 &&
        registryByteAt(path, 7 as usize) == 101 as u8 &&
        registryByteAt(path, 8 as usize) == 97 as u8 &&
        registryByteAt(path, 9 as usize) == 115 as u8 &&
        registryByteAt(path, 10 as usize) == 101 as u8 &&
        registryByteAt(path, 11 as usize) == 115 as u8
}

export function registryRouteCode(path: *u8, length: usize): int {
    if !registryPathSafe(path, length) { return 0 }
    if registryIsHealth(path, length) { return 1 }
    if registryIsStatus(path, length) { return 2 }
    if registryIsIndex(path, length) { return 3 }
    if registryIsPackages(path, length) { return 4 }
    if registryIsSearch(path, length) { return 5 }
    if registryIsAdvisories(path, length) { return 6 }
    if registryIsPackageSubresource(path, length) { return 7 }
    if registryIsDownloadPage(path, length) || registryIsDownloadPageSlash(path, length) { return 8 }
    if registryIsReleases(path, length) { return 9 }
    return 0
}

export function registryPortValid(port: int): bool { return port > 0 && port <= 65535 }
export function registryReleaseVisible(yanked: bool): bool { return !yanked }
export function registryServe(port: int): isize {
    if !registryPortValid(port) { return -1 }
    return registryHostServe("registry.noedb", "artifacts", port)
}
