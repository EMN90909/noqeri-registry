// Native Noqeri policy executable. The Go service owns sockets, archives,
// HTTP serialization and process lifecycle. No native C++ bridge is required.
import "../src/registry.noqeri"
function main(): int {
    if !registryRuntimePolicyReady() { return 1 }
    if !registryPaginationValid(0 as usize, 100 as usize) { return 2 }
    return 0
}
let registryPolicyExitCode: int = main()
