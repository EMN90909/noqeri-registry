// Native Noqeri application entry. Stage-0 executes top-level statements;
// merely declaring function main does NOT invoke it in generated AOT entry code.
import "../src/registry.noqeri"
function main(): int {
    let status: isize = registryServe(8080)
    if status < 0 { return 1 }
    return 0
}

// Execute the application from the AOT __entry function.
let registryExitCode: int = main()
