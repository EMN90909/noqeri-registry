{
  "format": "noqeri-package-quality-v2",
  "default": "experimental",
  "levels": {
    "noqeri/core": "core",
    "noqeri/std": "core",
    "noqeri/test": "preview",
    "noqeri/json": "preview",
    "noqeri/http": "preview",
    "noqeri/fs": "preview",
    "noqeri/db": "preview",
    "noqeri/time": "preview",
    "noqeri/security": "preview",
    "noqeri/uuid": "stable",
    "noqeri/retry": "stable",
    "noqeri/rate-limit": "stable",
    "noqeri/postgres": "experimental",
    "noqeri/mysql": "experimental",
    "noqeri/sqlite": "experimental",
    "noqeri/concurrency": "experimental",
    "noqeri/net": "experimental",
    "noqeri/tls": "experimental",
    "noqeri/http-client": "experimental"
  },
  "versionLevels": {
    "noqeri/concurrency@1.0.0": "experimental",
    "noqeri/concurrency@2.0.0": "preview"
  },
  "rule": "Version-specific quality overrides coordinate defaults. Provider stubs and APIs without executable advertised hosts remain experimental regardless of semantic version. Preview requires an executable reference implementation and regression evidence; stable/core require the stronger published compatibility gates."
}
